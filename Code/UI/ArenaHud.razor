@namespace LoopedLoaded
@inherits PanelComponent

<root>
	<div class="hud">

		<div class="notice @(Loop.NoticeVisible && !Loop.InMenu ? "on" : "off") @(Loop.HurtAmount > 0.2f ? "hurt" : "")">
			<label>@Loop.Notice</label>
		</div>

		@if ( !Loop.InCity && !Loop.InMenu && Loop.HurtAmount > 0.01f )
		{
			<div class="hurt-veil" style="opacity: @HurtVeil"></div>
			<div class="hurt-stamp">
				<label>@GameSettings.Text.Hud.HurtStamp</label>
			</div>
		}

		@if ( !Loop.InCity && !Loop.InMenu && Loop.Inventory.IsValid() )
		{
			<div class="run-left">
				<div class="hud-panel lap-panel">
					<div class="rivet a"></div>
					<div class="rivet b"></div>
					<div class="lap-row">
						<div class="lap-head">
							<label class="place">@(Loop.InBossFight ? Loop.BossName : Loop.LocationCode)</label>
							<label class="lap-value">@(Loop.InBossFight ? Loop.BossHealth : Loop.Lap)</label>
						</div>
						<label class="lap-clock">@TimeText</label>
					</div>
					<div class="bar">
						<div class="bar-fill @(Loop.InBossFight ? "boss" : "lap")" style="width: @(Loop.InBossFight ? BossPercent : LapPercent)%"></div>
					</div>
				</div>

				<div class="hud-panel brief-panel">
					@if ( Loop.HasTask )
					{
						<div class="brief-accent"></div>
						<label class="brief-kicker">@GameSettings.Text.Hud.Objective</label>
						<label class="brief-title">@Loop.TaskTitle</label>
						<label class="brief-blurb">@Loop.TaskBlurb</label>
						<div class="panel-split"></div>
					}
					<div class="trinkets">
						<label class="trinket-key">@GameSettings.Text.Hud.Trinkets</label>
						<label class="trinket-dash">—</label>
						@if ( EquippedTraits.Count == 0 )
						{
							<label class="trinket-none">@GameSettings.Text.Hud.TrinketsNone</label>
						}
						else
						{
							@foreach ( var trait in EquippedTraits )
							{
								<div class="trinket">
									<label>@(RoundTraits.OneShot( trait ) ? RoundTraits.Code( trait ) : $"{RoundTraits.Code( trait )}{TraitLevel( trait )}")</label>
								</div>
							}
						}
						@if ( Loop.BloodShields > 0 )
						{
							<label class="trinket-tag">@GameSettings.Text.F(GameSettings.Text.Hud.Shield, Loop.BloodShields)</label>
						}
						<label class="trinket-tag">@GameSettings.Text.F(GameSettings.Text.Hud.Threat, ThreatText)</label>
					</div>
				</div>
			</div>

			@if ( Loop.Phase != RunPhase.PickTrait )
			{
			<div class="run-right">
				<div class="hud-panel stat-panel">
					<div class="rivet a"></div>
					<div class="rivet b"></div>
					<div class="stat-row lead">
						<label class="key">@GameSettings.Text.Hud.Scrap</label>
						<label class="value">@Loop.Scrap</label>
					</div>
					<div class="stat-row lead">
						<label class="key">@GameSettings.Text.Hud.Stash</label>
						<label class="value">@Loop.Stash</label>
					</div>
					<div class="panel-split"></div>
					<div class="stat-row">
						<label class="key">@GameSettings.Text.Hud.Best</label>
						<label class="value">@Loop.BestExtract</label>
					</div>
					<div class="stat-row">
						<label class="key">@GameSettings.Text.Hud.Kills</label>
						<label class="value">@Loop.Kills</label>
					</div>
					<div class="stat-row">
						<label class="key">@GameSettings.Text.Hud.Caught</label>
						<label class="value">@Loop.ShotsFired</label>
					</div>
					<div class="stat-row">
						<label class="key">@GameSettings.Text.Hud.Fed</label>
						<label class="value">@GameSettings.Text.F(GameSettings.Text.Hud.FedValue, Loop.FedBiomass, Loop.WinNeed)</label>
					</div>
				</div>
			</div>
			}

			<div class="run-tray">
				<div class="tray">
					<div class="tray-cell">
						<label class="cell-key">@GameSettings.Text.Hud.Health</label>
						<div class="hp-row">
							@for ( var i = 0; i < Loop.HeartMax; i++ )
							{
								<div class="hp @(i < Loop.Health ? "live" : "dead") @(i < Loop.Health && Loop.HurtAmount > 0.08f ? "sting" : "")"></div>
							}
						</div>
					</div>

					<div class="cell-split"></div>

					<div class="tray-cell">
						<label class="cell-key">@GameSettings.Text.Hud.Ammo</label>
						<div class="round-row">
							@for ( var i = 0; i < MagCap; i++ )
							{
								<div class="round @MagPip( i )"></div>
							}
						</div>
						<div class="bar tray-bar">
							<div class="bar-fill dash @(ReloadReady ? "ready" : "")" style="width: @(ReloadPercent)%"></div>
						</div>
						<label class="cell-value">@(ReloadReady ? "RDY" : Loop.Inventory.Beaming ? "BOLT" : Loop.Inventory.ReloadLeft.ToString( "0.0" ))</label>
					</div>

					<div class="cell-split"></div>

					<div class="tray-cell">
						<label class="cell-key">@GameSettings.Text.Hud.Dash</label>
						<div class="bar tray-bar">
							<div class="bar-fill dash @(DashReady ? "ready" : "")" style="width: @(DashPercent)%"></div>
						</div>
						<label class="chip">@GameSettings.Text.Hud.DashKey</label>
					</div>

					@if ( SlowUnlocked )
					{
						<div class="cell-split"></div>

						<div class="tray-cell">
							<label class="cell-key">@GameSettings.Text.Hud.Slow</label>
							<div class="bar tray-bar">
								<div class="bar-fill slow @(Slowing ? "on" : "")" style="width: @(SlowPercent)%"></div>
							</div>
							<label class="chip">@GameSettings.Text.Hud.SlowKey</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.City && Loop.City.IsValid() )
		{
			<div class="city">
				<div class="top-left">
					<div class="lap-chip">
						<label class="key">@Loop.City.ModeLabel</label>
						<label class="value">@GameSettings.Text.F(GameSettings.Text.City.WarehouseHud, Loop.City.Warehouse)</label>
					</div>
					<div class="feed">
						<label class="feed-line">@GameSettings.Text.F(GameSettings.Text.Hud.FeedCount, Loop.FedBiomass, Loop.WinNeed)</label>
						<div class="meter">
							<div class="fill feed" style="width: @(FeedPercent)%"></div>
						</div>
					</div>
					<label class="mods">@Loop.City.HoverText()</label>
					<label class="clock">@CityBonuses</label>
					@if ( Loop.HasTask )
					{
						<div class="task">
							<label class="key">@GameSettings.Text.Hud.Task</label>
							<label class="title">@Loop.TaskTitle</label>
							<label class="blurb">@Loop.TaskBlurb</label>
						</div>
					}
				</div>
				<div class="bottom">
					@if ( Loop.City.Building )
					{
						<div class="blueprint">
							<div class="glyph @KindClass(Loop.City.Selected)">
								<div class="a"></div>
								<div class="b"></div>
								<div class="c"></div>
							</div>
							<div class="copy">
								<label class="title">@Buildings.Title(Loop.City.Selected)</label>
								<label class="payoff">@Buildings.Promise(Loop.City.Selected)</label>
								<label class="blurb">@Buildings.Blurb(Loop.City.Selected)</label>
								<label class="cost">@GameSettings.Text.F(GameSettings.Text.City.FrameHits, Buildings.FirstCost(Loop.City.Selected))</label>
							</div>
							<div class="promise">
								@if ( Loop.City.Selected == BuildingKind.Infirmary )
								{
									<div class="hearts">
										<div class="heart live"></div>
										<div class="heart live"></div>
										<div class="heart live"></div>
										<div class="heart add"></div>
									</div>
									<label class="tag">@GameSettings.Text.City.HpTag</label>
								}
								else
								{
									@if ( Loop.City.Selected == BuildingKind.Anvil )
									{
										<div class="shots">
											<div class="shot"></div>
											<div class="shot"></div>
											<div class="shot big"></div>
										</div>
										<label class="tag">@GameSettings.Text.City.DmgTag</label>
									}
									else
									{
										@if ( Loop.City.Selected == BuildingKind.Booster )
										{
											<div class="compare">
												<div class="dash">
													<label class="key">@GameSettings.Text.City.Now</label>
													<div class="meter"><div class="fill dash" style="width: 100%"></div></div>
												</div>
												<div class="dash">
													<label class="key">@GameSettings.Text.City.Then</label>
													<div class="meter"><div class="fill dash ready" style="width: 86%"></div></div>
												</div>
											</div>
										}
										else
										{
											@if ( Loop.City.Selected == BuildingKind.Brake )
											{
												<div class="dash">
													<label class="key">@GameSettings.Text.Hud.Slow</label>
													<div class="meter"><div class="fill slow on" style="width: 100%"></div></div>
												</div>
												<label class="tag">@GameSettings.Text.City.Unlocks</label>
											}
											else
											{
												<div class="mini-cards">
													<div class="mini-card"></div>
													<div class="mini-card"></div>
													<div class="mini-card add"></div>
												</div>
												<label class="tag">@GameSettings.Text.City.CardTag</label>
											}
										}
									}
								}
							</div>
						</div>
					}
					<div class="slots">
						@foreach ( var kind in Buildings.All )
						{
							<div class="slot @(kind == Loop.City.Selected ? "selected chambered" : "") @(Loop.City.Building ? "" : "idle")">
								<div class="glyph @KindClass(kind)">
									<div class="a"></div>
									<div class="b"></div>
									<div class="c"></div>
								</div>
								<div class="text">
									<label class="name">@((int)kind + 1)  @Buildings.Title(kind)</label>
									<label class="idx">@Buildings.Payoff(kind)</label>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		}

		<label class="help">@HelpText</label>

		@if ( Loop.CanPause )
		{
			<div class="pause-btn" onclick="@HitPause">
				<div class="pause-glyph">
					<div class="pause-bar"></div>
					<div class="pause-bar"></div>
				</div>
				<label>@GameSettings.Text.Pause.Button</label>
			</div>
		}

		@if ( Loop.Paused )
		{
			<div class="overlay menu">
				<label class="kicker">@GameSettings.Text.Pause.Kicker</label>
				<label class="overlay-title">@GameSettings.Text.Pause.Title</label>
				<label class="blurb">@GameSettings.Text.Pause.Blurb</label>
				@if ( Loop.HasTask )
				{
					<div class="task overlay-task">
						<label class="key">@GameSettings.Text.Hud.Task</label>
						<label class="title">@Loop.TaskTitle</label>
						<label class="blurb">@Loop.TaskBlurb</label>
					</div>
				}
				<div class="cards">
					<div class="card" onclick="@Resume">
						<label class="key">@GameSettings.Text.Pause.Key1</label>
						<label class="title">@GameSettings.Text.Pause.Resume</label>
						<label class="blurb">@GameSettings.Text.Pause.ResumeBlurb</label>
					</div>
					<div class="card" onclick="@PauseToMenu">
						<label class="key">@GameSettings.Text.Pause.Key2</label>
						<label class="title">@GameSettings.Text.Pause.Menu</label>
						<label class="blurb">@GameSettings.Text.Pause.MenuBlurb</label>
					</div>
					<div class="card" onclick="@QuitGame">
						<label class="key">@GameSettings.Text.Pause.Key3</label>
						<label class="title">@GameSettings.Text.Pause.Quit</label>
						<label class="blurb">@GameSettings.Text.Pause.QuitBlurb</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Title )
		{
			<div class="overlay title">
				<div class="title-scrim"></div>

				<div class="rail">
					<div class="brand">
						<div class="brand-slash"></div>
						<label class="brand-line">@BrandTop</label>
						<label class="brand-line">@BrandBottom</label>
					</div>

					<div class="brand-rule">
						<div class="rule-bar"></div>
						<label class="tagline">@GameSettings.Text.Menu.Tagline</label>
					</div>

					<div class="rail-list">
						@foreach ( var row in MainRows )
						{
							<div class="rail-row @(Loop.MenuFocus == row.Item ? "on" : "")" onmouseover="@(() => Loop.FocusMenu( row.Item ))" onclick="@(() => PickRow( row.Item ))">
								<div class="rivet a"></div>
								<div class="rivet b"></div>
								<label class="caret">play_arrow</label>
								<label class="row-title">@row.Title</label>
								<label class="row-key">@row.Key</label>
							</div>
						}
					</div>

					<div class="rail-split"></div>

					<div class="rail-list quiet">
						<div class="rail-row @(Loop.MenuFocus == MenuChoice.Settings ? "on" : "")" onmouseover="@(() => Loop.FocusMenu( MenuChoice.Settings ))" onclick="@(() => PickRow( MenuChoice.Settings ))">
							<label class="row-title">@GameSettings.Text.Menu.Settings</label>
						</div>
						<div class="rail-row @(Loop.MenuFocus == MenuChoice.Quit ? "on" : "")" onmouseover="@(() => Loop.FocusMenu( MenuChoice.Quit ))" onclick="@(() => PickRow( MenuChoice.Quit ))">
							<label class="row-title">@GameSettings.Text.Menu.Quit</label>
						</div>
					</div>

					<label class="rail-slot">@GameSettings.Text.F(GameSettings.Text.Menu.ActiveSave, Loop.ActiveSlot + 1)</label>

					<div class="rail-hint">
						<label class="icon">expand_less</label>
						<label class="icon">expand_more</label>
						<label class="word">@GameSettings.Text.Menu.NavigateHint</label>
						<label class="word">@GameSettings.Text.Menu.SelectHint</label>
					</div>
				</div>

				<div class="objective">
					<div class="rivet a"></div>
					<div class="rivet b"></div>
					<div class="rivet c"></div>
					<div class="rivet d"></div>
					<label class="obj-kicker">@GameSettings.Text.Menu.Objective</label>
					<label class="obj-title">@(Loop.HasTask ? Loop.TaskTitle : GameSettings.Text.Menu.ObjectiveDone)</label>
					@if ( Loop.HasTask )
					{
						<label class="obj-blurb">@Loop.TaskBlurb</label>
					}
					<div class="obj-split"></div>
					<div class="obj-stats">
						<div class="obj-stat">
							<label class="key">@GameSettings.Text.Menu.StatBiomass</label>
							<label class="value">@Loop.FedBiomass</label>
						</div>
						<div class="obj-stat">
							<label class="key">@GameSettings.Text.Menu.StatBest</label>
							<label class="value">@Loop.BestExtract</label>
						</div>
						<div class="obj-stat">
							<label class="key">@GameSettings.Text.Menu.StatOrgans</label>
							<label class="value">@Loop.OrganCount</label>
						</div>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Settings )
		{
			<div class="overlay title">
				<div class="title-scrim"></div>

				<div class="rail">
					<label class="page-kicker">@GameSettings.Text.Options.Kicker</label>
					<label class="page-title">@GameSettings.Text.Options.Title</label>

					<div class="brand-rule">
						<div class="rule-bar"></div>
						<label class="tagline">@GameSettings.Text.Options.Tagline</label>
					</div>

					<div class="rail-list">
						@foreach ( var row in SettingRows )
						{
							<div class="rail-row slider @(Loop.SettingCursor == row.Row ? "on" : "")" onmouseover="@(() => Loop.HighlightSetting( row.Row ))">
								<label class="row-title">@row.Title</label>
								<div class="ticks @TrackClass(row.Row)" onmousedown="@OnTrackDown">
									<div class="tick-fill" style="width: @(row.Steps * 22)px"></div>
									@for ( var n = 1; n < 10; n++ )
									{
										var at = n * 22;
										<div class="tick-mark" style="left: @(at)px"></div>
									}
								</div>
								<label class="row-value">@row.Value</label>
							</div>
						}
					</div>

					<div class="rail-split"></div>

					<div class="rail-list quiet">
						<div class="rail-row back" onclick="@BackToTitle">
							<label class="row-title">@GameSettings.Text.Options.Back</label>
						</div>
					</div>

					<div class="rail-hint">
						<label class="icon">expand_less</label>
						<label class="icon">expand_more</label>
						<label class="word">@GameSettings.Text.Menu.NavigateHint</label>
						<label class="icon">chevron_left</label>
						<label class="icon">chevron_right</label>
						<label class="word">@GameSettings.Text.Options.AdjustHint</label>
						<label class="word">@GameSettings.Text.Options.BackHint</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Saves )
		{
			<div class="overlay menu">
				<label class="kicker">@GameSettings.Text.Saves.Kicker</label>
				<label class="overlay-title">@GameSettings.Text.Saves.Title</label>
				<label class="blurb">@GameSettings.Text.Saves.Blurb</label>
				<div class="cards">
					<div class="card @(Loop.SaveCursor == 0 ? "selected" : "")" onclick="@HighlightSlot1">
						<label class="key">@GameSettings.Text.Saves.Key1</label>
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Slot, 1)</label>
						<label class="blurb">@Loop.SlotBlurb(0)</label>
					</div>
					<div class="card @(Loop.SaveCursor == 1 ? "selected" : "")" onclick="@HighlightSlot2">
						<label class="key">@GameSettings.Text.Saves.Key2</label>
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Slot, 2)</label>
						<label class="blurb">@Loop.SlotBlurb(1)</label>
					</div>
					<div class="card @(Loop.SaveCursor == 2 ? "selected" : "")" onclick="@HighlightSlot3">
						<label class="key">@GameSettings.Text.Saves.Key3</label>
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Slot, 3)</label>
						<label class="blurb">@Loop.SlotBlurb(2)</label>
					</div>
				</div>
				<div class="cards">
					<div class="card" onclick="@LoadHighlighted">
						<label class="key">@GameSettings.Text.Saves.KeySpace</label>
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Load, Loop.SaveCursor + 1)</label>
						<label class="blurb">@(Loop.SlotInfo(Loop.SaveCursor) is not null && Loop.SlotInfo(Loop.SaveCursor).HasProgress ? GameSettings.Text.Saves.LoadHas : GameSettings.Text.Saves.LoadEmpty)</label>
					</div>
					@if ( Loop.SlotExists( Loop.SaveCursor ) )
					{
						<div class="card" onclick="@DeleteHighlighted">
							<label class="key">@GameSettings.Text.Saves.KeyR</label>
							<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Delete, Loop.SaveCursor + 1)</label>
							<label class="blurb">@GameSettings.Text.Saves.DeleteBlurb</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.DecideLap )
		{
			<div class="overlay choose">
				<label class="overlay-title">@GameSettings.Text.F(GameSettings.Text.Decide.LapClear, Loop.Lap)</label>
				<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.LapBlurb, Loop.Stash, Loop.Scrap)</label>
				<div class="cards">
					<div class="card" onclick="@ChooseExtract">
						<label class="key">@GameSettings.Text.Decide.Key1</label>
						<label class="title">@GameSettings.Text.Decide.Extract</label>
						<label class="blurb">@ExtractBank(Loop.Stash)</label>
					</div>
					<div class="card" onclick="@ChooseContinue">
						<label class="key">@GameSettings.Text.Decide.Key2</label>
						<label class="title">@GameSettings.Text.Decide.OneMore</label>
						<label class="blurb">@GameSettings.Text.Decide.OneMoreBlurb</label>
					</div>
					@if ( Loop.HasBossOffer )
					{
						<div class="card" onclick="@ChooseBoss">
							<label class="key">@GameSettings.Text.Decide.Key3</label>
							<label class="title">@GameSettings.Text.F(GameSettings.Text.Decide.Fight, Loop.BossName)</label>
							<label class="blurb">@Locations.BossBlurb( Loop.Location, !Loop.HasNextRing )</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.DecideRing )
		{
			<div class="overlay choose">
				<label class="overlay-title">@GameSettings.Text.Decide.RingClear</label>
				<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.RingBlurb, Loop.Stash, Loop.NextRingCode, Loop.NextRingRule)</label>
				<div class="cards">
					<div class="card" onclick="@ChooseExtract">
						<label class="key">@GameSettings.Text.Decide.Key1</label>
						<label class="title">@GameSettings.Text.Decide.Extract</label>
						<label class="blurb">@ExtractBank(Loop.Stash)</label>
					</div>
					@if ( Loop.HasNextRing )
					{
						<div class="card" onclick="@ChooseNextRing">
							<label class="key">@GameSettings.Text.Decide.Key2</label>
							<label class="title">@GameSettings.Text.Decide.NextRing</label>
							<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.NextRingBlurb, Loop.NextRingCode, Loop.NextRingRule)</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.PickTrait )
		{
			<div class="overlay choose shop">
				<div class="shop-head">
					<label class="overlay-title">@GameSettings.Text.Shop.Title</label>
					<div class="shop-bones">
						<label class="key">@GameSettings.Text.Hud.Scrap</label>
						<label class="value">@Loop.Scrap</label>
					</div>
				</div>
				<label class="blurb shop-line">@GameSettings.Text.F(GameSettings.Text.Shop.Blurb, Loop.Scrap)</label>
				<div class="cards">
					@for ( var i = 0; i < Loop.Offers.Count; i++ )
					{
						var index = i;
						var trait = Loop.Offers[index].Trait;
						var bought = Loop.Offers[index].Bought;
						<div class="card @OfferClass(trait, bought)" style="border-color: @TraitBorder(trait)" @key="@((int)trait)" onmouseover="@(() => HoverShop(index))" onclick="@(() => PickOffer(index))">
							<label class="key">@GameSettings.Text.Shop.KeyOf(index)</label>
							<label class="title">@RoundTraits.Title(trait)</label>
							<label class="rarity">@RoundTraits.Rarity(trait)</label>
							<label class="blurb">@OfferBlurb(trait, bought)</label>
							<div class="stats">
								@foreach ( var line in OfferStats( trait, bought ) )
								{
									<label class="stat @line.Class">@line.Text</label>
								}
							</div>
							<label class="cost">@OfferCost(trait, bought)</label>
						</div>
					}
				</div>
				<div class="cards">
					@if ( Loop.ShopHasBundle )
					{
						<div class="card @(Loop.ShopCanBuyAll ? "" : "poor")" onmouseover="@LeaveShop" onclick="@BuyAllOffers">
							<label class="key">@GameSettings.Text.Shop.KeyE</label>
							<label class="title">@GameSettings.Text.Shop.BuyAll</label>
							<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Shop.BuyAllBlurb, Loop.ShopBuyAllCost)</label>
							<label class="cost">@GameSettings.Text.F(GameSettings.Text.Shop.Cost, Loop.ShopBuyAllCost)</label>
						</div>
					}
					<div class="card" onmouseover="@LeaveShop" onclick="@FinishShop">
						<label class="key">@GameSettings.Text.Shop.KeySpace</label>
						<label class="title">@GameSettings.Text.Shop.Go</label>
						<label class="blurb">@GameSettings.Text.Shop.GoBlurb</label>
					</div>
				</div>
				<div class="shop-sheet">
					<div class="sheet-lead">
						<label class="key">@GameSettings.Text.Hud.Scrap</label>
						<label class="value">@Loop.Scrap</label>
					</div>
					<label class="sheet-kicker">WEAPON</label>
					@foreach ( var row in ShopWeapon )
					{
						<div class="sheet-row">
							<label class="key">@row.Label</label>
							<div class="vals">
								<label class="now">@row.Now</label>
								@if ( row.Next != "" )
								{
									<label class="arrow">→</label>
									<label class="next @row.NextClass">@row.Next</label>
								}
							</div>
						</div>
					}
					<label class="sheet-kicker">HERO</label>
					@foreach ( var row in ShopHero )
					{
						<div class="sheet-row">
							<label class="key">@row.Label</label>
							<div class="vals">
								<label class="now">@row.Now</label>
							</div>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Dead )
		{
			<div class="overlay choose">
				<label class="overlay-title">@GameSettings.Text.Decide.Dead</label>
				<label class="blurb">@(Loop.BurnedRounds == 1 ? GameSettings.Text.F(GameSettings.Text.Decide.DeadBurnedOne, Loop.BurnedRounds) : GameSettings.Text.F(GameSettings.Text.Decide.DeadBurnedMany, Loop.BurnedRounds))</label>
				<div class="cards">
					<div class="card" onclick="@GoCity">
						<label class="key">@GameSettings.Text.Decide.KeyR</label>
						<label class="title">@GameSettings.Text.Decide.City</label>
						<label class="blurb">@GameSettings.Text.Decide.DeadCityBlurb</label>
					</div>
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Extracted )
		{
			<div class="overlay choose showcase">
				<label class="kicker">@GameSettings.Text.Decide.ShowcaseKicker  ·  @GameSettings.Text.F(GameSettings.Text.Decide.ShowcaseCount, Loop.TaskDone, Loop.TaskTotal)</label>
				<label class="overlay-title">@GameSettings.Text.Decide.Extracted</label>
				<label class="blurb">@(Loop.ExtractedRounds == 1 ? GameSettings.Text.F(GameSettings.Text.Decide.ExtractedOne, Loop.ExtractedRounds, Loop.BestExtract) : GameSettings.Text.F(GameSettings.Text.Decide.ExtractedMany, Loop.ExtractedRounds, Loop.BestExtract))</label>
				<div class="reel">
					@for ( var i = 0; i < Loop.CompletedTasks.Count; i++ )
					{
						var step = Loop.CompletedTasks[i];
						<div class="beat" style="animation-delay: @(i * 70)ms">
							<div class="mark"></div>
							<div class="copy">
								<label class="title">@step.Title</label>
								<label class="blurb">@step.Blurb</label>
							</div>
						</div>
					}
				</div>
				<div class="cards">
					<div class="card" onclick="@GoCity">
						<label class="key">@GameSettings.Text.Shop.KeySpace</label>
						<label class="title">@GameSettings.Text.Menu.Continue</label>
						<label class="blurb">@GameSettings.Text.Decide.ShowcaseContinue</label>
					</div>
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Won )
		{
			<div class="overlay menu victory" onclick="@PlayAgain">
				<label class="kicker">@GameSettings.Text.Decide.WonKicker</label>
				<label class="overlay-title">@GameSettings.Text.Decide.Won</label>
				<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.WonBlurb, Loop.FedBiomass)</label>
				<div class="cards">
					<div class="card" onclick="@PlayAgain">
						<label class="key">@GameSettings.Text.Decide.WonKey</label>
						<label class="title">@GameSettings.Text.Decide.WonPlay</label>
						<label class="blurb">@GameSettings.Text.Decide.WonPlayBlurb</label>
					</div>
				</div>
			</div>
		}

	</div>

	<div class="cursor-trail"></div>
	<div class="cursor-aura">
		<div class="cursor-ring"></div>
		<div class="cursor-dot"></div>
	</div>
</root>

@code
{
	[Property] public GameLoop Loop { get; set; }

	protected override void OnTreeFirstBuilt()
	{
		Panel.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
	}

	protected override void OnUpdate()
	{
		if ( Panel is null || !Loop.IsValid() )
			return;

		Panel.Style.PointerEvents = Loop.WantsUiCursor || Loop.CanPause
			? Sandbox.UI.PointerEvents.All
			: Sandbox.UI.PointerEvents.None;

		TickCursor();
		TickHover();
		TickSettingDrag();

		if ( Loop.Phase != RunPhase.PickTrait )
			shopHover = -1;
	}

	void Resume() => Loop?.Resume();
	void HitPause()
	{
		Loop?.NoteUiClick();
		Loop?.Pause();
	}
	void PauseToMenu() => Loop?.ShowMenu();
	void StartRun() => Loop?.Restart();

	void PickRow( MenuChoice item )
	{
		Loop?.NoteUiClick();
		Loop?.ActivateMenu( item );
	}

	List<(MenuChoice Item, string Title, string Key)> MainRows
	{
		get
		{
			var copy = GameSettings.Text.Menu;
			return new()
			{
				(MenuChoice.Continue, Loop.IsValid() && Loop.HasActiveSave ? copy.Continue : copy.Play, copy.Key1),
				(MenuChoice.Upgrades, copy.City, copy.Key2),
				(MenuChoice.Saves, copy.Saves, copy.Key3)
			};
		}
	}

	void BackToTitle()
	{
		Loop?.NoteUiClick();
		Loop?.CloseSettings();
	}

	SettingRow? trackScrub;

	static string TrackClass( SettingRow row ) => row switch
	{
		SettingRow.Sfx => "track-sfx",
		SettingRow.Shake => "track-shake",
		_ => "track-music"
	};

	static bool TryRow( Sandbox.UI.Panel track, out SettingRow row )
	{
		row = SettingRow.Music;

		if ( !track.IsValid() )
			return false;

		if ( track.HasClass( "track-sfx" ) )
			row = SettingRow.Sfx;
		else if ( track.HasClass( "track-shake" ) )
			row = SettingRow.Shake;
		else if ( !track.HasClass( "track-music" ) )
			return false;

		return true;
	}

	void OnTrackDown()
	{
		var track = HoveredTrack();
		if ( !TryRow( track, out var row ) )
			return;

		trackScrub = row;
		Loop?.NoteUiClick();
		ApplyTrack( row, track );
	}

	Sandbox.UI.Panel HoveredTrack()
	{
		if ( Panel is null )
			return null;

		Sandbox.UI.Panel under = null;

		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "ticks" ) )
				continue;

			if ( child.HasHovered )
				return child;

			if ( under is null && UnderCursor( child ) )
				under = child;
		}

		return under;
	}

	static bool UnderCursor( Sandbox.UI.Panel panel )
	{
		var width = panel.Box.Rect.Width;
		var height = panel.Box.Rect.Height;
		if ( width < 1f || height < 1f )
			return false;

		var mouse = panel.MousePosition;
		return mouse.x >= 0f && mouse.y >= 0f && mouse.x <= width && mouse.y <= height;
	}

	void TickSettingDrag()
	{
		if ( trackScrub is not SettingRow row )
			return;

		if ( !Loop.IsValid() || Loop.MenuView != MenuPage.Settings || !Input.Down( "Attack1" ) )
		{
			trackScrub = null;
			return;
		}

		ApplyTrack( row, null );
	}

	void ApplyTrack( SettingRow row, Sandbox.UI.Panel track )
	{
		track ??= FindHud( TrackClass( row ) );
		if ( !track.IsValid() || !Loop.IsValid() )
			return;

		var width = track.Box.Rect.Width;
		if ( width < 1f )
			return;

		var across = Math.Clamp( track.MousePosition.x / width, 0f, 1f );
		var steps = (int)MathF.Round( across * 10f );
		Loop.SetSetting( row, steps );
	}

	List<(SettingRow Row, string Title, string Value, int Steps)> SettingRows
	{
		get
		{
			var copy = GameSettings.Text.Options;
			var list = new List<(SettingRow, string, string, int)>();
			foreach ( var row in GameLoop.SettingOrder )
			{
				var title = row switch
				{
					SettingRow.Music => copy.Music,
					SettingRow.Sfx => copy.Sfx,
					_ => copy.Shake
				};

				var steps = UserSettings.Steps( row );
				var value = steps == 0 ? copy.Off : GameSettings.Text.F( copy.Value, UserSettings.Percent( row ) );
				list.Add( (row, title, value, steps) );
			}

			return list;
		}
	}

	string BrandTop
	{
		get
		{
			var title = (GameSettings.Text.Menu.Title ?? "").ToUpperInvariant();
			var split = title.IndexOf( '&' );
			return split < 0 ? title : title.Substring( 0, split + 1 ).Trim();
		}
	}

	string BrandBottom
	{
		get
		{
			var title = (GameSettings.Text.Menu.Title ?? "").ToUpperInvariant();
			var split = title.IndexOf( '&' );
			return split < 0 ? "" : title.Substring( split + 1 ).Trim();
		}
	}

	void OpenCity() => Loop?.OpenCityFromMenu();
	void OpenSaves() => Loop?.OpenSaves();
	void HighlightSlot1() => Loop?.HighlightSave( 0 );
	void HighlightSlot2() => Loop?.HighlightSave( 1 );
	void HighlightSlot3() => Loop?.HighlightSave( 2 );
	void LoadHighlighted() => Loop?.UseSave( Loop.SaveCursor );
	void DeleteHighlighted() => Loop?.DeleteSave( Loop.SaveCursor );
	void QuitGame() => Loop?.QuitGame();
	void ChooseExtract() => Loop?.ChooseExtract();
	void ChooseContinue() => Loop?.ChooseContinue();
	void ChooseBoss() => Loop?.ChooseBoss();
	void ChooseNextRing() => Loop?.ChooseNextRing();
	void PickOffer( int index ) => Loop?.ChooseUpgradeAt( index );
	void BuyAllOffers() => Loop?.ChooseBuyAll();
	void FinishShop() => Loop?.ChooseShopGo();
	void HoverShop( int index ) => shopHover = index;
	void LeaveShop() => shopHover = -1;
	void GoCity()
	{
		Loop?.NoteUiClick();
		Loop?.ChooseCity();
	}
	void PlayAgain()
	{
		Loop?.NoteUiClick();
		Loop?.PlayAgain();
	}

	int LapPercent => Loop.IsValid() ? (int)(Loop.LapFraction * 100f) : 0;
	int BossPercent => Loop.IsValid() && Loop.BossMaxHealth > 0 ? (int)(Loop.BossHealth / (float)Loop.BossMaxHealth * 100f) : 0;
	int FeedPercent => Loop.IsValid() && Loop.WinNeed > 0 ? (int)(Math.Clamp( Loop.FedBiomass / (float)Loop.WinNeed, 0f, 1f ) * 100f) : 0;
	int HurtPercent => Loop.IsValid() ? (int)(Loop.HurtAmount * 100f) : 0;
	string HurtVeil => (Loop.IsValid() ? Loop.HurtAmount * 0.55f : 0f).ToString( "0.###" );
	int DashPercent => Runner.IsValid() ? (int)(Runner.DashCharge * 100f) : 0;
	int SlowPercent => Runner.IsValid() ? (int)(Runner.SlowCharge * 100f) : 0;
	int ReloadPercent => Loop.IsValid() && Loop.Inventory.IsValid() ? (int)(Loop.Inventory.Reload01 * 100f) : 0;
	bool ReloadReady => Loop.IsValid() && Loop.Inventory.IsValid() && Loop.Inventory.Ready;
	int MagCap => Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.MagCap : 0;
	string MagPip( int index )
	{
		if ( !Loop.IsValid() || !Loop.Inventory.IsValid() )
			return "";

		var mag = Loop.Inventory;
		if ( index < mag.MagLoaded )
			return "chambered";
		if ( index < mag.MagLoaded + mag.MagFlight )
			return "inflight";
		if ( index < mag.MagLoaded + mag.MagFlight + mag.MagDropped )
			return "dropped";
		return "";
	}
	bool DashReady => Runner.IsValid() && Runner.DashCharge >= 1f;
	bool SlowUnlocked => Runner.IsValid() && Runner.SlowUnlocked;
	bool Slowing => Runner.IsValid() && Runner.Slowing;
	RingRunner Runner => Loop.IsValid() ? Loop.Runner : null;

	string TimeText
	{
		get
		{
			if ( !Loop.IsValid() ) return "0:00";
			var total = (int)Loop.RunTime;
			return $"{total / 60}:{total % 60:00}";
		}
	}

	string GlobalMods
	{
		get
		{
			if ( !Loop.IsValid() || !Loop.Inventory.IsValid() ) return GameSettings.Text.Hud.Plain;
			var parts = new List<string>();
			foreach ( var trait in RoundTraits.All )
			{
				var level = Loop.Inventory.Loadout.TraitLevel( trait );
				if ( level > 0 )
					parts.Add( $"{RoundTraits.Code( trait )}{level}" );
			}

			var body = parts.Count == 0 ? GameSettings.Text.Hud.Plain : string.Join( "  ", parts );
			if ( Loop.BloodShields > 0 )
				body += $"  {GameSettings.Text.F( GameSettings.Text.Hud.Shield, Loop.BloodShields )}";

			return $"{body}  ×{Loop.Threat:0.00}";
		}
	}

	List<RoundTrait> EquippedTraits
	{
		get
		{
			var list = new List<RoundTrait>();
			if ( !Loop.IsValid() || !Loop.Inventory.IsValid() )
				return list;

			foreach ( var trait in RoundTraits.All )
			{
				if ( Loop.Inventory.Loadout.TraitLevel( trait ) > 0 )
					list.Add( trait );
			}

			return list;
		}
	}

	int TraitLevel( RoundTrait trait ) => Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.Loadout.TraitLevel( trait ) : 0;
	string ThreatText => Loop.IsValid() ? Loop.Threat.ToString( "0.00" ) : "1.00";

	string HelpText
	{
		get
		{
			if ( !Loop.IsValid() )
				return "";

			if ( Loop.Paused )
				return GameSettings.Text.Help.Paused;

			if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Saves )
				return GameSettings.Text.Help.Saves;

			if ( Loop.Phase == RunPhase.Menu )
				return "";

			return Loop.Phase switch
			{
				RunPhase.Menu => GameSettings.Text.Help.Menu,
				RunPhase.City => Loop.City.IsValid() && Loop.City.Building
					? GameSettings.Text.Help.CityBuild
					: GameSettings.Text.Help.CityShoot,
				RunPhase.DecideLap => Loop.HasBossOffer ? GameSettings.Text.F( GameSettings.Text.Help.DecideLapBoss, Loop.BossName ) : GameSettings.Text.Help.DecideLap,
				RunPhase.DecideRing => Loop.HasNextRing ? GameSettings.Text.Help.DecideRingNext : GameSettings.Text.Help.DecideRing,
				RunPhase.PickTrait => GameSettings.Text.F( GameSettings.Text.Help.Shop, Loop.Offers.Count ),
				RunPhase.Dead => GameSettings.Text.Help.Dead,
				RunPhase.Extracted => GameSettings.Text.Help.Extracted,
				RunPhase.Won => GameSettings.Text.Help.Won,
				_ => Loop.InBossFight
					? Loop.Location == RunLocation.Glass
						? GameSettings.Text.Help.BossGlass
						: GameSettings.Text.Help.BossYard
					: Loop.Location == RunLocation.Glass
						? Loop.CanSkipLap
							? GameSettings.Text.Help.PlayGlassSkip
							: GameSettings.Text.Help.PlayGlass
						: Loop.CanSkipLap
							? GameSettings.Text.Help.PlaySkip
							: GameSettings.Text.Help.Play
			};
		}
	}

	string CityBonuses
	{
		get
		{
			if ( !Loop.IsValid() || !Loop.City.IsValid() )
				return GameSettings.Text.City.NoBonuses;

			var stats = Loop.City.Stats();
			var parts = new List<string>();
			if ( stats.BonusHealth > 0 ) parts.Add( GameSettings.Text.F( GameSettings.Text.City.BonusHp, stats.BonusHealth ) );
			if ( stats.BonusDamage > 0 ) parts.Add( GameSettings.Text.F( GameSettings.Text.City.BonusDmg, stats.BonusDamage ) );
			if ( stats.DashCooldownScale < 0.99f ) parts.Add( GameSettings.Text.City.BonusDash );
			if ( stats.SlowUnlocked ) parts.Add( GameSettings.Text.City.BonusSlow );
			if ( stats.OfferCount > GameSettings.City.MinOffers ) parts.Add( GameSettings.Text.F( GameSettings.Text.City.BonusCards, stats.OfferCount ) );
			return parts.Count == 0 ? GameSettings.Text.City.NoBonuses : string.Join( "  ", parts );
		}
	}

	string KindClass( BuildingKind kind ) => kind.ToString().ToLowerInvariant();

	string ExtractBank( int stash ) => stash == 1
		? GameSettings.Text.F( GameSettings.Text.Decide.ExtractBankOne, stash )
		: GameSettings.Text.F( GameSettings.Text.Decide.ExtractBankMany, stash );

	List<StatLine> OfferStats( RoundTrait trait, bool bought )
	{
		var level = TraitLevel( trait );
		var rank = bought ? Math.Max( 1, level ) : Math.Min( RoundTraits.MaxLevel( trait ), level + 1 );
		return StatSheet.Effects( trait, rank );
	}

	string OfferBlurb( RoundTrait trait, bool bought )
	{
		var text = RoundTraits.Blurb( trait );
		if ( string.IsNullOrWhiteSpace( text ) )
			return "";

		if ( RoundTraits.OneShot( trait ) )
			return text;

		var level = TraitLevel( trait );
		var shown = bought ? Math.Max( 1, level ) : Math.Min( RoundTraits.MaxLevel( trait ), level + 1 );
		return GameSettings.Text.F( GameSettings.Text.Shop.OfferBlurb, text, shown );
	}

	RoundTrait? ShopPreview
	{
		get
		{
			if ( !Loop.IsValid() || Loop.Phase != RunPhase.PickTrait )
				return null;

			if ( shopHover < 0 || shopHover >= Loop.Offers.Count )
				return null;

			var offer = Loop.Offers[shopHover];
			if ( offer.Bought || Loop.TraitLocked( offer.Trait ) )
				return null;

			return offer.Trait;
		}
	}

	List<SheetRow> ShopWeapon => StatSheet.Weapon( Loop, ShopPreview );
	List<SheetRow> ShopHero => StatSheet.Hero( Loop );

	string OfferCost( RoundTrait trait, bool bought )
	{
		if ( bought )
			return GameSettings.Text.Shop.Bought;

		if ( Loop.IsValid() && Loop.TraitLocked( trait ) )
			return GameSettings.Text.Shop.Locked;

		if ( !Loop.IsValid() )
			return "";

		return GameSettings.Text.F( GameSettings.Text.Shop.Cost, Loop.PriceOf( trait ) );
	}

	string OfferClass( RoundTrait trait, bool bought )
	{
		if ( bought )
			return "upgrade bought";

		if ( Loop.IsValid() && Loop.TraitLocked( trait ) )
			return "upgrade poor locked";

		if ( Loop.IsValid() && Loop.Scrap < Loop.PriceOf( trait ) )
			return "upgrade poor";

		return "upgrade";
	}

	string TraitBorder( RoundTrait trait )
	{
		var c = RoundTraits.Color( trait );
		return $"rgba({(int)(c.r * 255)},{(int)(c.g * 255)},{(int)(c.b * 255)}, 0.85)";
	}

	float auraX;
	float auraY;
	float trailX;
	float trailY;
	Sandbox.UI.Panel auraPanel;
	Sandbox.UI.Panel trailPanel;
	Sandbox.UI.Panel hotCard;
	int shopHover = -1;

	void TickCursor()
	{
		var show = Loop.IsValid() && Loop.WantsUiCursor;

		if ( !auraPanel.IsValid() )
			auraPanel = FindHud( "cursor-aura" );
		if ( !trailPanel.IsValid() )
			trailPanel = FindHud( "cursor-trail" );

		var want = CursorOn();
		var snap = !show || (trailX == 0f && trailY == 0f);
		var drag = MathF.Min( 1f, Time.Delta * 9f );

		auraX = want.x;
		auraY = want.y;

		if ( snap )
		{
			trailX = want.x;
			trailY = want.y;
		}
		else
		{
			trailX = MathX.Lerp( trailX, want.x, drag );
			trailY = MathX.Lerp( trailY, want.y, drag );
		}

		PlaceCursor( auraPanel, auraX, auraY, show );
		PlaceCursor( trailPanel, trailX, trailY, show );
	}

	Vector2 CursorOn()
	{
		var origin = Panel;
		if ( origin is null )
			return Vector2.Zero;

		var scale = origin.ScaleFromScreen;
		if ( scale <= 0.0001f )
			scale = 1f;

		return Mouse.Position * scale;
	}

	Sandbox.UI.Panel FindHud( string className )
	{
		if ( Panel is null )
			return null;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( className ) )
				return child;
		}

		return null;
	}

	static void PlaceCursor( Sandbox.UI.Panel target, float x, float y, bool show )
	{
		if ( !target.IsValid() )
			return;

		target.SetClass( "on", show );
		target.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
		target.Style.Left = Sandbox.UI.Length.Pixels( x );
		target.Style.Top = Sandbox.UI.Length.Pixels( y );
		target.Style.Dirty();
	}

	void TickHover()
	{
		if ( Panel is null || !Loop.IsValid() || !Loop.WantsUiCursor )
		{
			ClearHover();
			return;
		}

		Sandbox.UI.Panel over = null;
		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasHovered )
				over = child;
		}

		var card = over;
		while ( card.IsValid() && !card.HasClass( "card" ) )
			card = card.Parent;

		var picking = false;
		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "card" ) )
				continue;

			var on = child == card;
			if ( child.HasClass( "hot" ) != on )
				child.SetClass( "hot", on );

			if ( on )
				picking = true;
		}

		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "overlay" ) )
				continue;

			child.SetClass( "picking", picking && child.HasClass( "menu" ) );
		}

		if ( card.IsValid() && card != hotCard && (hotCard is null || hotCard.IsValid()) )
			ArenaSounds.MenuMove();

		hotCard = card.IsValid() ? card : null;
	}

	void ClearHover()
	{
		if ( Panel is null )
			return;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( "hot" ) )
				child.SetClass( "hot", false );
			if ( child.HasClass( "picking" ) )
				child.SetClass( "picking", false );
		}

		hotCard = null;
	}

	protected override int BuildHash()
	{
		var a = System.HashCode.Combine(
			Loop.IsValid() ? Loop.Lap : 0,
			Loop.IsValid() ? Loop.Health : 0,
			Loop.IsValid() ? (int)Loop.Phase : 0,
			LapPercent,
			DashPercent,
			Loop.IsValid() ? Loop.Stash : 0,
			Loop.IsValid() && Loop.Inventory.IsValid() ? ReloadPercent : 0,
			System.HashCode.Combine(
				Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.MagLoaded : 0,
				Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.MagFlight : 0,
				Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.MagDropped : 0,
				Loop.IsValid() && Loop.NoticeVisible ) );

		var b = System.HashCode.Combine(
			Loop.IsValid() ? Loop.Notice : "",
			TimeText,
			GlobalMods,
			Loop.IsValid() ? Loop.Kills : 0,
			Loop.IsValid() ? Loop.BestExtract : 0,
			Loop.IsValid() ? Loop.ExtractedRounds : 0,
			Loop.IsValid() ? Loop.BurnedRounds : 0,
			Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.ShotsFired : 0 );

		var c = System.HashCode.Combine(
			Loop.IsValid() && Loop.City.IsValid() ? Loop.City.Warehouse : 0,
			Loop.IsValid() && Loop.City.IsValid() ? (int)Loop.City.Selected : 0,
			Loop.IsValid() && Loop.City.IsValid() ? Loop.City.HoverText() : "",
			Loop.IsValid() ? Loop.Offers.Count : 0,
			Loop.IsValid() ? Loop.HeartMax : 0,
			CityBonuses,
			HurtPercent,
			Loop.IsValid() && Loop.InBossFight );

		var d = System.HashCode.Combine(
			Loop.IsValid() ? Loop.BossHealth : 0,
			Loop.IsValid() && Loop.HasBossOffer,
			Loop.IsValid() && Loop.City.IsValid() ? Loop.City.PlacementFacing : 0,
			Loop.IsValid() && Loop.City.IsValid() ? (int)Loop.City.Mode : 0,
			Loop.IsValid() && Loop.Paused,
			Loop.IsValid() ? (int)Loop.MenuView : 0,
			Loop.IsValid() ? Loop.ActiveSlot : 0,
			Loop.IsValid() ? Loop.SaveCursor : 0 );

		var e = System.HashCode.Combine(
			Loop.IsValid() ? Loop.SlotBlurb( 0 ) : "",
			Loop.IsValid() ? Loop.SlotBlurb( 1 ) : "",
			Loop.IsValid() ? Loop.SlotBlurb( 2 ) : "",
			Loop.IsValid() && Loop.SlotExists( 0 ),
			Loop.IsValid() && Loop.SlotExists( 1 ),
			Loop.IsValid() && Loop.SlotExists( 2 ),
			Loop.IsValid() && Loop.CanSkipLap,
			Loop.IsValid() && Loop.CanPause );

		var f = System.HashCode.Combine(
			Loop.IsValid() ? Loop.Scrap : 0,
			Loop.IsValid() ? Loop.OfferStamp : 0,
			Loop.IsValid() && Loop.ShopHasBundle,
			Loop.IsValid() && Loop.ShopCanBuyAll,
			Loop.IsValid() ? Loop.ShopBuyAllCost : 0,
			shopHover );

		var g = System.HashCode.Combine(
			Loop.IsValid() ? (int)Loop.Location : 0,
			Loop.IsValid() ? Loop.BestLine : -1,
			Loop.IsValid() && Loop.HasNextRing,
			Loop.IsValid() ? Loop.TaskStamp : "",
			Loop.IsValid() && Loop.HasTask,
			Loop.IsValid() ? Loop.TaskDone : 0,
			Loop.IsValid() ? Loop.FedBiomass : 0,
			System.HashCode.Combine(
				Loop.IsValid() ? (int)Loop.MenuFocus : 0,
				Loop.IsValid() ? Loop.OrganCount : 0,
				Loop.IsValid() ? (int)Loop.SettingCursor : 0,
				UserSettings.Steps( SettingRow.Music ),
				UserSettings.Steps( SettingRow.Sfx ),
				UserSettings.Steps( SettingRow.Shake ) ) );

		return System.HashCode.Combine( a, b, c, d, e, f, g );
	}
