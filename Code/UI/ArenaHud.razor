@namespace LoopedLoaded
@inherits PanelComponent

<root>
	@if ( Loop.IsValid() )
	{
	<div class="hud">

		@if ( !Loop.Paused && (Loop.Phase == RunPhase.DecideLap || Loop.Phase == RunPhase.DecideRing || Loop.Phase == RunPhase.PickTrait) )
		{
			<div class="scene-dim"></div>
		}

		<div class="notice @(Loop.NoticeVisible && !Loop.InMenu ? "on" : "off") @(Loop.HurtAmount > 0.2f ? "hurt" : "")">
			<label>@Loop.Notice</label>
		</div>

		@if ( !Loop.InCity && !Loop.InMenu && Loop.HurtAmount > 0.01f )
		{
			<div class="hurt-veil" style="opacity: @HurtVeil"></div>
			<div class="hurt-stamp">
				<label>@GameSettings.Text.Hud.HurtStamp</label>
			</div>
		}

		@if ( !Loop.InCity && !Loop.InMenu && Loop.Inventory.IsValid() )
		{
			<div class="run-left">
				<div class="hud-panel lap-panel">
					<img class="lap-back" src="ui/Arena UI/element_back_double.png" />
					<div class="lap-face">
						<label class="place">@(Loop.InBossFight ? Loop.BossName : "ROUND")</label>
						<label class="lap-value">@(Loop.InBossFight ? Loop.BossHealth : Loop.Lap)</label>
					</div>
					<div class="lap-side">
						<label class="lap-clock">@TimeText</label>
					</div>
				</div>

				<div class="hud-panel brief-panel">
					<img class="brief-back" src="ui/Arena UI/element_back_two_floors.png" />
					<div class="brief-face">
						@if ( Loop.HasTask )
						{
							<label class="brief-kicker">@GameSettings.Text.Hud.Objective</label>
							<label class="brief-title">@Loop.TaskTitle</label>
							<label class="brief-blurb">@Loop.TaskBlurb</label>
						}
					</div>
					<div class="brief-floor">
						<label class="key">@GameSettings.Text.Hud.Fed</label>
						<label class="value">@GameSettings.Text.F(GameSettings.Text.Hud.FedValue, Loop.FedBiomass, Loop.WinNeed)</label>
					</div>
				</div>
			</div>

			<div class="run-right">
				<div class="hud-panel stat-panel">
					<img class="stat-back" src="ui/Arena UI/default_element_back.png" />
					<div class="stat-face">
						<div class="stat-row lead">
							<label class="key">@GameSettings.Text.Hud.Scrap</label>
							<label class="value">@Loop.Scrap</label>
						</div>
						<div class="stat-row lead">
							<label class="key">@GameSettings.Text.Hud.Stash</label>
							<label class="value">@Loop.Stash</label>
						</div>
					</div>
				</div>
			</div>

			<div class="tray-frame">
				<img class="tray-back" src="ui/Arena UI/back.png" />
				<HudFace class="face-slot" Loop="@Loop"></HudFace>
				<div class="health-slot">
					<label class="health-key">@GameSettings.Text.Hud.Health</label>
					<div class="hp-row">
						@for ( var i = 0; i < Loop.HeartMax; i++ )
						{
							<img class="hp @(i < Loop.Health ? "live" : "dead") @(i < Loop.Health && Loop.HurtAmount > 0.08f ? "sting" : "")" src="@(i < Loop.Health ? "ui/Arena UI/health.png" : "ui/Arena UI/health_empty.png")" />
						}
					</div>
				</div>
				<div class="ammo-slot">
					<label class="ammo-key">@GameSettings.Text.Hud.Ammo</label>
					<img class="round" src="ui/Arena UI/ammo.png" />
					<label class="ammo-count">@MagLoaded</label>
				</div>
				<div class="dash-slot">
					<div class="meter-row">
						<label class="meter-key">@GameSettings.Text.Hud.Dash</label>
						<div class="charge-meter">
							<img class="charge-layer" src="ui/Arena UI/dash_empty.png" />
							<div class="charge-reveal" style="width: @(DashPercent)%">
								<img class="charge-layer" src="ui/Arena UI/dash.png" />
							</div>
						</div>
					</div>
					@if ( SlowUnlocked )
					{
						<div class="meter-row">
							<label class="meter-key">@GameSettings.Text.Hud.Slow</label>
							<div class="charge-meter slow">
								<img class="charge-layer" src="ui/Arena UI/slow_empty.png" />
								<div class="charge-reveal" style="width: @(SlowPercent)%">
									<img class="charge-layer" src="ui/Arena UI/slow.png" />
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.City && Loop.City.IsValid() )
		{
			<div class="city">
				<div class="top-left">
					<div class="hud-panel brief-panel">
						<img class="brief-back" src="ui/Arena UI/element_back_two_floors.png" />
						<div class="brief-face">
							@if ( Loop.HasTask )
							{
								<label class="brief-kicker">@GameSettings.Text.Hud.Objective</label>
								<label class="brief-title">@Loop.TaskTitle</label>
								<label class="brief-blurb">@Loop.TaskBlurb</label>
							}
						</div>
						<div class="brief-floor">
							<label class="key">@GameSettings.Text.Hud.Fed</label>
							<label class="value">@GameSettings.Text.F(GameSettings.Text.Hud.FedValue, Loop.FedBiomass, Loop.WinNeed)</label>
						</div>
					</div>
					<div class="city-controls">
						<label>@(Loop.City.Building ? "LMB BUILD" : "LMB INJECT")</label>
						<label>RMB DELETE UNFINISHED / ROTATE</label>
					</div>
					<div class="city-run" onclick="@CityRun">
						<img src="ui/Arena UI/element_shop_bottom_btn.png" />
						<label>RUN</label>
					</div>
				</div>
				<div class="altar-tray">
					<img class="altar-back" src="ui/Arena UI/altar_back.png" />
				</div>
				<div class="bottom" style="bottom: @(OrganLift)px">
					<div class="blueprint">
							<img class="blueprint-back" src="ui/Arena UI/default_element_back.png" />
							<div class="blueprint-face">
								<img class="organ-art @KindClass(Loop.City.Selected)" src="@OrganArt(Loop.City.Selected)" />
								<div class="copy">
									<label class="title">@Buildings.Title(Loop.City.Selected)</label>
									<label class="payoff">@Buildings.Promise(Loop.City.Selected)</label>
									@if ( !string.IsNullOrWhiteSpace( Buildings.Blurb( Loop.City.Selected ) ) )
									{
										<label class="blurb">@Buildings.Blurb(Loop.City.Selected)</label>
									}
								</div>
								<label class="cost">@Buildings.FrameCost(Loop.City.Selected, Loop.City.Placed(Loop.City.Selected)) biomass</label>
							</div>
						</div>
				</div>
				<div class="altar-notches">
					@foreach ( var kind in Buildings.All )
					{
						<div class="altar-notch" onclick="@(() => PickOrgan( kind ))">
							<img class="notch-lamp" src="ui/Arena UI/selection_lamp_empty.png" />
							@if ( kind == Loop.City.Selected )
							{
								<img class="notch-lamp" src="ui/Arena UI/selection_lamp.png" />
							}
							<div class="slot @KindClass(kind) @(kind == Loop.City.Selected ? "selected chambered" : "")">
								<img class="organ-art @KindClass(kind)" src="@OrganArt(kind)" />
								<div class="text">
									<label class="name">@Buildings.Title(kind)</label>
									<label class="idx">@Buildings.Payoff(kind)</label>
								</div>
							</div>
						</div>
					}
				</div>
				<div class="city-side">
					<div class="hud-panel stat-panel">
						<img class="stat-back" src="ui/Arena UI/default_element_back.png" />
						<div class="stat-face">
							<div class="stat-row lead city-biomass">
								<label class="key">BIOMASS</label>
								<label class="value">@Loop.City.Warehouse</label>
							</div>
						</div>
					</div>
					@if ( CityBonusLines.Count > 0 )
					{
						<div class="city-stats">
							<img class="city-stats-back" src="ui/Arena UI/element_back_square.png" />
							<div class="city-stats-face">
								@foreach ( var line in CityBonusLines )
								{
									<div class="city-stat-row">
										<label class="name">@line.Name</label>
										<label class="value">@line.Value</label>
									</div>
								}
							</div>
						</div>
					}
				</div>
			</div>
		}

		@if ( Loop.Phase != RunPhase.City )
		{
			<label class="help">@HelpText</label>
		}

		@if ( Loop.CanPause )
		{
			<div class="pause-btn" onclick="@HitPause">
				<div class="pause-glyph">
					<div class="pause-bar"></div>
					<div class="pause-bar"></div>
				</div>
				<label>@GameSettings.Text.Pause.Button</label>
			</div>
		}

		@if ( Loop.Paused )
		{
			<div class="overlay menu">
				<label class="kicker">@GameSettings.Text.Pause.Kicker</label>
				<label class="overlay-title">@GameSettings.Text.Pause.Title</label>
				<label class="blurb">@GameSettings.Text.Pause.Blurb</label>
				@if ( Loop.HasTask )
				{
					<div class="task overlay-task">
						<label class="key">@GameSettings.Text.Hud.Task</label>
						<label class="title">@Loop.TaskTitle</label>
						<label class="blurb">@Loop.TaskBlurb</label>
					</div>
				}
				<div class="cards">
					<div class="card" onclick="@Resume">
						<label class="key">@GameSettings.Text.Pause.Key1</label>
						<label class="title">@GameSettings.Text.Pause.Resume</label>
						<label class="blurb">@GameSettings.Text.Pause.ResumeBlurb</label>
					</div>
					<div class="card" onclick="@PauseToMenu">
						<label class="key">@GameSettings.Text.Pause.Key2</label>
						<label class="title">@GameSettings.Text.Pause.Menu</label>
						<label class="blurb">@GameSettings.Text.Pause.MenuBlurb</label>
					</div>
					<div class="card" onclick="@QuitGame">
						<label class="key">@GameSettings.Text.Pause.Key3</label>
						<label class="title">@GameSettings.Text.Pause.Quit</label>
						<label class="blurb">@GameSettings.Text.Pause.QuitBlurb</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Title )
		{
			<div class="overlay title">
				<div class="title-scrim"></div>

				<div class="rail">
					<div class="brand">
						<img class="brand-logo" src="ui/Arena UI/LoopedAndLoadedALPHA.png" />
					</div>

					<div class="brand-rule">
						<div class="rule-bar"></div>
						<label class="tagline">@GameSettings.Text.Menu.Tagline</label>
					</div>

					<div class="rail-list">
						@foreach ( var row in MainRows )
						{
							<div class="rail-row plated @(Loop.MenuFocus == row.Item ? "on" : "")" onmouseover="@(() => Loop.FocusMenu( row.Item ))" onclick="@(() => PickRow( row.Item ))">
								<img class="row-plate" src="ui/Arena UI/element_shop_bottom_btn.png" />
								<div class="row-tint"></div>
								<div class="rivet a"></div>
								<div class="rivet b"></div>
								<label class="row-title">@row.Title</label>
							</div>
						}
					</div>

					<div class="rail-list quiet">
						<div class="rail-row plated @(Loop.MenuFocus == MenuChoice.Settings ? "on" : "")" onmouseover="@(() => Loop.FocusMenu( MenuChoice.Settings ))" onclick="@(() => PickRow( MenuChoice.Settings ))">
							<img class="row-plate" src="ui/Arena UI/element_shop_bottom_btn.png" />
							<div class="row-tint"></div>
							<label class="row-title">@GameSettings.Text.Menu.Settings</label>
						</div>
						<div class="rail-row plated @(Loop.MenuFocus == MenuChoice.Quit ? "on" : "")" onmouseover="@(() => Loop.FocusMenu( MenuChoice.Quit ))" onclick="@(() => PickRow( MenuChoice.Quit ))">
							<img class="row-plate" src="ui/Arena UI/element_shop_bottom_btn.png" />
							<div class="row-tint"></div>
							<label class="row-title">@GameSettings.Text.Menu.Quit</label>
						</div>
					</div>
				</div>

				<div class="objective">
					<img class="obj-back" src="ui/Arena UI/element_back_double_two_floors.png" />
					<div class="obj-face">
						<label class="obj-kicker">@GameSettings.Text.Menu.Objective</label>
						<label class="obj-title">@(Loop.HasTask ? Loop.TaskTitle : GameSettings.Text.Menu.ObjectiveDone)</label>
						@if ( Loop.HasTask )
						{
							<label class="obj-blurb">@Loop.TaskBlurb</label>
						}
					</div>
					<div class="obj-biomass">
						<label class="key">@GameSettings.Text.Hud.Fed</label>
						<label class="value">@GameSettings.Text.F(GameSettings.Text.Hud.FedValue, Loop.FedBiomass, Loop.WinNeed)</label>
					</div>
					<div class="obj-organs">
						<label class="key">@GameSettings.Text.Menu.StatOrgans</label>
						<label class="value">@Loop.OrganCount</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Settings )
		{
			<div class="overlay title">
				<div class="title-scrim"></div>

				<div class="rail">
					<label class="page-kicker">@GameSettings.Text.Options.Kicker</label>
					<label class="page-title">@GameSettings.Text.Options.Title</label>

					<div class="brand-rule">
						<div class="rule-bar"></div>
						<label class="tagline">@GameSettings.Text.Options.Tagline</label>
					</div>

					<div class="rail-list">
						<div class="rail-row preset @(Loop.SettingCursor == SettingRow.Graphics ? "on" : "")" onmouseover="@(() => Loop?.HighlightSetting( SettingRow.Graphics ))" onclick="@(() => CycleGraphics())">
							<label class="row-title">@GameSettings.Text.Options.Graphics</label>
							<label class="row-value">@GraphicsLabel</label>
						</div>
						@foreach ( var row in SettingRows )
						{
							<div class="rail-row slider @(Loop.SettingCursor == row.Row ? "on" : "")" onmouseover="@(() => Loop.HighlightSetting( row.Row ))">
								<label class="row-title">@row.Title</label>
								<div class="ticks @TrackClass(row.Row)" onmousedown="@OnTrackDown">
									<div class="tick-fill" style="width: @(row.Steps * 22)px"></div>
									@for ( var n = 1; n < 10; n++ )
									{
										var at = n * 22;
										<div class="tick-mark" style="left: @(at)px"></div>
									}
								</div>
								<label class="row-value">@row.Value</label>
							</div>
						}
					</div>

					<div class="rail-split"></div>

					<div class="rail-list quiet">
						<div class="rail-row back" onclick="@BackToTitle">
							<label class="row-title">@GameSettings.Text.Options.Back</label>
						</div>
					</div>

					<div class="rail-hint">
						<label class="icon">expand_less</label>
						<label class="icon">expand_more</label>
						<label class="word">@GameSettings.Text.Menu.NavigateHint</label>
						<label class="icon">chevron_left</label>
						<label class="icon">chevron_right</label>
						<label class="word">@GameSettings.Text.Options.AdjustHint</label>
						<label class="word">@GameSettings.Text.Options.BackHint</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Saves )
		{
			<div class="overlay menu">
				<div class="save-plate">
					<img class="save-back" src="ui/Arena UI/element_back_three_slots.png" />
					<label class="save-title">@GameSettings.Text.Saves.Title</label>
					<div class="save-slot a @(Loop.SaveCursor == 0 ? "selected" : "")" onclick="@HighlightSlot1">
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Slot, 1)</label>
						<div class="save-lines">
							<label class="blurb">@Loop.SlotBiomass(0)</label>
							@if ( Loop.SlotHasProgress( 0 ) )
							{
								<label class="blurb">@Loop.SlotOrgans(0)</label>
							}
						</div>
					</div>
					<div class="save-slot b @(Loop.SaveCursor == 1 ? "selected" : "")" onclick="@HighlightSlot2">
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Slot, 2)</label>
						<div class="save-lines">
							<label class="blurb">@Loop.SlotBiomass(1)</label>
							@if ( Loop.SlotHasProgress( 1 ) )
							{
								<label class="blurb">@Loop.SlotOrgans(1)</label>
							}
						</div>
					</div>
					<div class="save-slot c @(Loop.SaveCursor == 2 ? "selected" : "")" onclick="@HighlightSlot3">
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Saves.Slot, 3)</label>
						<div class="save-lines">
							<label class="blurb">@Loop.SlotBiomass(2)</label>
							@if ( Loop.SlotHasProgress( 2 ) )
							{
								<label class="blurb">@Loop.SlotOrgans(2)</label>
							}
						</div>
					</div>
					<div class="save-actions">
						<div class="save-btn" onclick="@ReturnToMenu">
							<img class="save-btn-back" src="ui/Arena UI/small_button.png" />
							<label class="title">RETURN</label>
						</div>
						<div class="save-btn" onclick="@LoadHighlighted">
							<img class="save-btn-back" src="ui/Arena UI/small_button.png" />
							<label class="title">LOAD</label>
						</div>
						@if ( Loop.SlotExists( Loop.SaveCursor ) )
						{
							<div class="save-btn" onclick="@DeleteHighlighted">
								<img class="save-btn-back" src="ui/Arena UI/small_button.png" />
								<label class="title">DELETE</label>
							</div>
						}
					</div>
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.DecideLap )
		{
			<div class="overlay choose over-hud">
				<div class="choice-plate">
					<img class="choice-back" src="ui/Arena UI/element_back_buttons.png" />
					<div class="choice-copy">
						<label class="choice-title">@GameSettings.Text.F(GameSettings.Text.Decide.LapClear, Loop.Lap)</label>
						<label class="choice-line">@GameSettings.Text.Decide.LapBlurb</label>
					</div>
					<div class="choice-hit left" onclick="@ChooseExtract">
						<img class="choice-btn" src="ui/Arena UI/buttons_left.png" />
						<div class="choice-label">
							<label class="choice-key">@GameSettings.Text.Decide.Key1</label>
							<label class="choice-name">@GameSettings.Text.Decide.Extract</label>
						</div>
					</div>
					<div class="choice-hit right" onclick="@ChooseContinue">
						<img class="choice-btn" src="ui/Arena UI/buttons_right.png" />
						<div class="choice-label">
							<label class="choice-key">@GameSettings.Text.Decide.Key2</label>
							<label class="choice-name">@GameSettings.Text.Decide.OneMore</label>
						</div>
					</div>
				</div>
				@if ( Loop.HasBossOffer )
				{
					<div class="card choice-boss" onclick="@ChooseBoss">
						<label class="key">@GameSettings.Text.Decide.Key3</label>
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Decide.Fight, Loop.BossName)</label>
					</div>
				}
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.DecideRing )
		{
			<div class="overlay choose over-hud">
				<label class="overlay-title">@GameSettings.Text.Decide.RingClear</label>
				<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.RingBlurb, Loop.Stash, Loop.NextRingCode, Loop.NextRingRule)</label>
				<div class="cards">
					<div class="card" onclick="@ChooseExtract">
						<label class="key">@GameSettings.Text.Decide.Key1</label>
						<label class="title">@GameSettings.Text.Decide.Extract</label>
						<label class="blurb">@ExtractBank(Loop.Stash)</label>
					</div>
					@if ( Loop.HasNextRing )
					{
						<div class="card" onclick="@ChooseNextRing">
							<label class="key">@GameSettings.Text.Decide.Key2</label>
							<label class="title">@GameSettings.Text.Decide.NextRing</label>
							<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.NextRingBlurb, Loop.NextRingCode, Loop.NextRingRule)</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.PickTrait )
		{
			<div class="overlay choose shop over-hud">
				<div class="shop-head">
					<label class="overlay-title">@GameSettings.Text.Shop.Title</label>
				</div>
				<div class="cards shop-cards">
					@for ( var i = 0; i < Loop.Offers.Count; i++ )
					{
						var index = i;
						var trait = Loop.Offers[index].Trait;
						var bought = Loop.Offers[index].Bought;
						<div class="card shop-offer @OfferClass(trait, bought)" style="border-color: @TraitBorder(trait)" @key="@((int)trait)" onmouseover="@(() => HoverShop(index))" onclick="@(() => PickOffer(index))">
							<img class="shop-plate" src="@(Loop.Offers[index].LeftPlate ? "ui/Arena UI/element_shop_left_btn.png" : "ui/Arena UI/element_shop_right_btn.png")" />
							<div class="shop-body">
								<label class="title">@RoundTraits.Title(trait)</label>
								<label class="rarity" style="color: @TraitInk(trait)">@RoundTraits.Rarity(trait)</label>
								@if ( OfferBlurb( trait, bought ) is { Length: > 0 } blurb )
								{
									<label class="blurb">@blurb</label>
								}
								<div class="stats">
									@foreach ( var line in OfferStats( trait, bought ) )
									{
										<label class="stat @line.Class">@line.Text</label>
									}
								</div>
							</div>
							<label class="cost">@OfferCost(trait, bought)</label>
						</div>
					}
				</div>
				<div class="cards shop-go">
					<div class="card shop-go-btn @RefreshClass" onmouseover="@LeaveShop" onclick="@RefreshShop">
						<img class="shop-plate" src="ui/Arena UI/element_shop_bottom_btn.png" />
						<div class="shop-go-copy">
							<label class="title">@GameSettings.Text.Shop.Refresh</label>
							<label class="cost">@GameSettings.Text.F(GameSettings.Text.Shop.Cost, Loop.ShopRefreshCost)</label>
						</div>
					</div>
					<div class="card shop-go-btn" onmouseover="@LeaveShop" onclick="@FinishShop">
						<img class="shop-plate" src="ui/Arena UI/element_shop_bottom_btn.png" />
						<label class="title">@GameSettings.Text.Shop.Go</label>
					</div>
				</div>
				<div class="shop-sheet">
					<label class="sheet-kicker">WEAPON</label>
					@foreach ( var row in ShopWeapon )
					{
						<div class="sheet-row">
							<label class="key">@row.Label</label>
							<div class="vals">
								<label class="now">@row.Now</label>
								@if ( row.Next != "" )
								{
									<label class="arrow">→</label>
									<label class="next @row.NextClass">@row.Next</label>
								}
							</div>
						</div>
					}
					<label class="sheet-kicker">HERO</label>
					@foreach ( var row in ShopHero )
					{
						<div class="sheet-row">
							<label class="key">@row.Label</label>
							<div class="vals">
								<label class="now">@row.Now</label>
							</div>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Dead )
		{
			<div class="overlay choose">
				<label class="overlay-title">@GameSettings.Text.Decide.Dead</label>
				<label class="blurb">@(Loop.BurnedRounds == 1 ? GameSettings.Text.F(GameSettings.Text.Decide.DeadBurnedOne, Loop.BurnedRounds) : GameSettings.Text.F(GameSettings.Text.Decide.DeadBurnedMany, Loop.BurnedRounds))</label>
				<div class="cards">
					<div class="card" onclick="@GoCity">
						<label class="key">@GameSettings.Text.Decide.KeyR</label>
						<label class="title">@GameSettings.Text.Decide.City</label>
						<label class="blurb">@GameSettings.Text.Decide.DeadCityBlurb</label>
					</div>
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Extracted )
		{
			<div class="overlay choose showcase">
				<label class="kicker">@GameSettings.Text.Decide.ShowcaseKicker  ·  @GameSettings.Text.F(GameSettings.Text.Decide.ShowcaseCount, Loop.TaskDone, Loop.TaskTotal)</label>
				<label class="overlay-title">@GameSettings.Text.Decide.Extracted</label>
				<label class="blurb">@(Loop.ExtractedRounds == 1 ? GameSettings.Text.F(GameSettings.Text.Decide.ExtractedOne, Loop.ExtractedRounds, Loop.BestExtract) : GameSettings.Text.F(GameSettings.Text.Decide.ExtractedMany, Loop.ExtractedRounds, Loop.BestExtract))</label>
				<div class="reel">
					@for ( var i = 0; i < Loop.CompletedTasks.Count; i++ )
					{
						var step = Loop.CompletedTasks[i];
						<div class="beat" style="animation-delay: @(i * 70)ms">
							<div class="mark"></div>
							<div class="copy">
								<label class="title">@step.Title</label>
								<label class="blurb">@step.Blurb</label>
							</div>
						</div>
					}
				</div>
				<div class="cards">
					<div class="card" onclick="@GoCity">
						<label class="key">@GameSettings.Text.Shop.KeySpace</label>
						<label class="title">@GameSettings.Text.Menu.Continue</label>
						<label class="blurb">@GameSettings.Text.Decide.ShowcaseContinue</label>
					</div>
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Won )
		{
			<div class="overlay menu victory">
				<label class="kicker">@(Loop.Ascend > 0 ? GameSettings.Text.F(GameSettings.Text.Decide.WonKickerAscend, Loop.Ascend) : GameSettings.Text.Decide.WonKicker)</label>
				<label class="overlay-title">@GameSettings.Text.Decide.Won</label>
				<label class="blurb">@GameSettings.Text.F(GameSettings.Text.Decide.WonBlurb, Loop.FedBiomass)</label>
				<div class="cards">
					<div class="card" onclick="@ChooseAscend">
						<label class="key">@GameSettings.Text.Decide.Key1</label>
						<label class="title">@GameSettings.Text.F(GameSettings.Text.Decide.WonAscend, Loop.Ascend + 1)</label>
						<label class="blurb">@GameSettings.Text.Decide.WonAscendBlurb</label>
						<div class="stats">
							<label class="stat down">@GameSettings.Text.F(GameSettings.Text.Decide.WonAscendHealth, Progression.AscendHealth(Loop.Ascend + 1))</label>
							<label class="stat up">@GameSettings.Text.F(GameSettings.Text.Decide.WonAscendReward, Progression.AscendReward(Loop.Ascend + 1))</label>
							<label class="stat note">@GameSettings.Text.F(GameSettings.Text.Decide.WonAscendFeed, Progression.WinNeed(Loop.Ascend + 1))</label>
						</div>
					</div>
					<div class="card" onclick="@ChooseKeep">
						<label class="key">@GameSettings.Text.Decide.Key2</label>
						<label class="title">@GameSettings.Text.Decide.WonKeep</label>
						<label class="blurb">@GameSettings.Text.Decide.WonKeepBlurb</label>
					</div>
				</div>
			</div>
		}

	</div>
	}

	<div class="cursor-trail"></div>
	<div class="cursor-aura">
		<div class="cursor-ring"></div>
		<div class="cursor-dot"></div>
	</div>
	<div class="shot-cursor">
		<div class="reload-track"></div>
		@for ( var i = 0; i < ReloadMarks; i++ )
		{
			<div class="reload-mark"></div>
		}
	</div>
</root>

@code
{
	[Property] public GameLoop Loop { get; set; }

	protected override void OnTreeFirstBuilt()
	{
		Panel.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
	}

	protected override void OnUpdate()
	{
		if ( Panel is null || !Loop.IsValid() )
			return;

		Panel.Style.PointerEvents = Loop.WantsUiCursor || Loop.CanPause
			? Sandbox.UI.PointerEvents.All
			: Sandbox.UI.PointerEvents.None;

		TickCursor();
		TickReloadCursor();
		TickHover();
		TickSettingDrag();
		TickTraySize();
		TickHurtVeil();

		if ( Loop.Phase != RunPhase.PickTrait )
			shopHover = -1;
	}

	void Resume() => Loop?.Resume();
	void HitPause()
	{
		Loop?.NoteUiClick();
		Loop?.Pause();
	}
	void PauseToMenu() => Loop?.ShowMenu();
	void StartRun() => Loop?.Restart();
	void CityRun()
	{
		Loop?.NoteUiClick();
		Loop?.Restart();
	}

	void PickRow( MenuChoice item )
	{
		Loop?.NoteUiClick();
		Loop?.ActivateMenu( item );
	}

	List<(MenuChoice Item, string Title, string Key)> MainRows
	{
		get
		{
			var copy = GameSettings.Text.Menu;
			return new()
			{
				(MenuChoice.Continue, Loop.IsValid() && Loop.HasActiveSave ? copy.Continue : copy.Play, copy.Key1),
				(MenuChoice.Upgrades, "ALTAR", copy.Key2),
				(MenuChoice.Saves, copy.Saves, copy.Key3)
			};
		}
	}

	void BackToTitle()
	{
		Loop?.NoteUiClick();
		Loop?.CloseSettings();
	}

	void CycleGraphics()
	{
		Loop?.NoteUiClick();
		Loop?.NudgeSetting( SettingRow.Graphics, 1 );
	}

	string GraphicsLabel => UserSettings.Graphics switch
	{
		GraphicsPreset.Low => GameSettings.Text.Options.GraphicsLow,
		GraphicsPreset.Medium => GameSettings.Text.Options.GraphicsMedium,
		_ => GameSettings.Text.Options.GraphicsHigh
	};

	void TickHurtVeil()
	{
		if ( !Loop.IsValid() )
			return;

		var veil = FindHud( "hurt-veil" );
		if ( !veil.IsValid() )
			return;

		veil.Style.Opacity = Loop.HurtAmount * 0.55f;
	}

	SettingRow? trackScrub;

	static string TrackClass( SettingRow row ) => row switch
	{
		SettingRow.Sfx => "track-sfx",
		SettingRow.Shake => "track-shake",
		_ => "track-music"
	};

	static bool TryRow( Sandbox.UI.Panel track, out SettingRow row )
	{
		row = SettingRow.Music;

		if ( !track.IsValid() )
			return false;

		if ( track.HasClass( "track-sfx" ) )
			row = SettingRow.Sfx;
		else if ( track.HasClass( "track-shake" ) )
			row = SettingRow.Shake;
		else if ( !track.HasClass( "track-music" ) )
			return false;

		return true;
	}

	void OnTrackDown()
	{
		var track = HoveredTrack();
		if ( !TryRow( track, out var row ) )
			return;

		trackScrub = row;
		Loop?.NoteUiClick();
		ApplyTrack( row, track );
	}

	Sandbox.UI.Panel HoveredTrack()
	{
		if ( Panel is null )
			return null;

		Sandbox.UI.Panel under = null;

		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "ticks" ) )
				continue;

			if ( child.HasHovered )
				return child;

			if ( under is null && UnderCursor( child ) )
				under = child;
		}

		return under;
	}

	static bool UnderCursor( Sandbox.UI.Panel panel )
	{
		var width = panel.Box.Rect.Width;
		var height = panel.Box.Rect.Height;
		if ( width < 1f || height < 1f )
			return false;

		var mouse = panel.MousePosition;
		return mouse.x >= 0f && mouse.y >= 0f && mouse.x <= width && mouse.y <= height;
	}

	void TickSettingDrag()
	{
		if ( trackScrub is not SettingRow row )
			return;

		if ( !Loop.IsValid() || Loop.MenuView != MenuPage.Settings || !Input.Down( "Attack1" ) )
		{
			trackScrub = null;
			return;
		}

		ApplyTrack( row, null );
	}

	void ApplyTrack( SettingRow row, Sandbox.UI.Panel track )
	{
		track ??= FindHud( TrackClass( row ) );
		if ( !track.IsValid() || !Loop.IsValid() )
			return;

		var width = track.Box.Rect.Width;
		if ( width < 1f )
			return;

		var across = Math.Clamp( track.MousePosition.x / width, 0f, 1f );
		var steps = (int)MathF.Round( across * 10f );
		Loop.SetSetting( row, steps );
	}

	List<(SettingRow Row, string Title, string Value, int Steps)> SettingRows
	{
		get
		{
			var copy = GameSettings.Text.Options;
			var list = new List<(SettingRow, string, string, int)>();
			foreach ( var row in GameLoop.SettingOrder )
			{
				if ( row == SettingRow.Graphics )
					continue;

				var title = row switch
				{
					SettingRow.Music => copy.Music,
					SettingRow.Sfx => copy.Sfx,
					_ => copy.Shake
				};

				var steps = UserSettings.Steps( row );
				var value = steps == 0 ? copy.Off : GameSettings.Text.F( copy.Value, UserSettings.Percent( row ) );
				list.Add( (row, title, value, steps) );
			}

			return list;
		}
	}

	void OpenCity() => Loop?.OpenCityFromMenu();
	void OpenSaves() => Loop?.OpenSaves();
	void HighlightSlot1() => Loop?.HighlightSave( 0 );
	void HighlightSlot2() => Loop?.HighlightSave( 1 );
	void HighlightSlot3() => Loop?.HighlightSave( 2 );
	void ReturnToMenu()
	{
		Loop?.NoteUiClick();
		Loop?.CloseSaves();
	}
	void LoadHighlighted() => Loop?.UseSave( Loop.SaveCursor );
	void DeleteHighlighted() => Loop?.DeleteSave( Loop.SaveCursor );
	void QuitGame() => Loop?.QuitGame();
	void ChooseExtract() => Loop?.ChooseExtract();
	void ChooseContinue() => Loop?.ChooseContinue();
	void ChooseBoss() => Loop?.ChooseBoss();
	void ChooseNextRing() => Loop?.ChooseNextRing();
	void PickOffer( int index ) => Loop?.ChooseUpgradeAt( index );
	void BuyAllOffers() => Loop?.ChooseBuyAll();
	void FinishShop() => Loop?.ChooseShopGo();
	void RefreshShop() => Loop?.ChooseRefreshShop();
	void HoverShop( int index ) => shopHover = index;
	void LeaveShop() => shopHover = -1;
	void PickOrgan( BuildingKind kind )
	{
		if ( !Loop.IsValid() || !Loop.City.IsValid() )
			return;

		Loop.NoteUiClick();
		Loop.City.Choose( kind );
	}

	void GoCity()
	{
		Loop?.NoteUiClick();
		Loop?.ChooseCity();
	}
	void ChooseAscend()
	{
		Loop?.NoteUiClick();
		Loop?.ChooseAscend();
	}

	void ChooseKeep()
	{
		Loop?.NoteUiClick();
		Loop?.ChooseKeep();
	}

	int FeedPercent => Loop.IsValid() && Loop.WinNeed > 0 ? (int)(Math.Clamp( Loop.FedBiomass / (float)Loop.WinNeed, 0f, 1f ) * 100f) : 0;
	int HurtPercent => Loop.IsValid() ? (int)(Loop.HurtAmount * 100f) : 0;
	string HurtVeil => (Loop.IsValid() ? Loop.HurtAmount * 0.55f : 0f).ToString( "0.###" );
	int DashPercent => Runner.IsValid() ? (int)(Runner.DashCharge * 100f) : 0;
	int SlowPercent => Runner.IsValid() ? (int)(Runner.SlowCharge * 100f) : 0;
	int ReloadPercent => Loop.IsValid() && Loop.Inventory.IsValid() ? (int)(Loop.Inventory.Reload01 * 100f) : 0;
	int MagLoaded => Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.MagLoaded : 0;
	bool DashReady => Runner.IsValid() && Runner.DashCharge >= 1f;
	bool SlowUnlocked => Runner.IsValid() && Runner.SlowUnlocked;
	bool Slowing => Runner.IsValid() && Runner.Slowing;
	RingRunner Runner => Loop.IsValid() ? Loop.Runner : null;

	string TimeText
	{
		get
		{
			if ( !Loop.IsValid() ) return "0:00";
			var total = (int)Loop.RunTime;
			return $"{total / 60}:{total % 60:00}";
		}
	}

	string GlobalMods
	{
		get
		{
			if ( !Loop.IsValid() || !Loop.Inventory.IsValid() ) return GameSettings.Text.Hud.Plain;
			var parts = new List<string>();
			foreach ( var trait in RoundTraits.All )
			{
				var level = Loop.Inventory.Loadout.TraitLevel( trait );
				if ( level > 0 )
					parts.Add( $"{RoundTraits.Code( trait )}{level}" );
			}

			var body = parts.Count == 0 ? GameSettings.Text.Hud.Plain : string.Join( "  ", parts );
			return $"{body}  ×{Loop.Threat:0.00}";
		}
	}

	int TraitLevel( RoundTrait trait ) => Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.Loadout.TraitLevel( trait ) : 0;

	string HelpText
	{
		get
		{
			if ( !Loop.IsValid() )
				return "";

			if ( Loop.Paused )
				return GameSettings.Text.Help.Paused;

			if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Saves )
				return GameSettings.Text.Help.Saves;

			if ( Loop.Phase == RunPhase.Menu )
				return "";

			return Loop.Phase switch
			{
				RunPhase.Menu => GameSettings.Text.Help.Menu,
				RunPhase.City => Loop.City.IsValid() && Loop.City.Building
					? GameSettings.Text.Help.CityBuild
					: GameSettings.Text.Help.CityShoot,
				RunPhase.DecideLap => Loop.HasBossOffer ? GameSettings.Text.F( GameSettings.Text.Help.DecideLapBoss, Loop.BossName ) : GameSettings.Text.Help.DecideLap,
				RunPhase.DecideRing => Loop.HasNextRing ? GameSettings.Text.Help.DecideRingNext : GameSettings.Text.Help.DecideRing,
				RunPhase.PickTrait => GameSettings.Text.F( GameSettings.Text.Help.Shop, Loop.Offers.Count ),
				RunPhase.Dead => GameSettings.Text.Help.Dead,
				RunPhase.Extracted => GameSettings.Text.Help.Extracted,
				RunPhase.Won => GameSettings.Text.Help.Won,
				_ => Loop.InBossFight
					? Loop.Location == RunLocation.Glass
						? GameSettings.Text.Help.BossGlass
						: GameSettings.Text.Help.BossYard
					: Loop.Location == RunLocation.Glass
						? Loop.CanSkipLap
							? GameSettings.Text.Help.PlayGlassSkip
							: GameSettings.Text.Help.PlayGlass
						: Loop.CanSkipLap
							? GameSettings.Text.Help.PlaySkip
							: GameSettings.Text.Help.Play
			};
		}
	}

	readonly struct CityBonus
	{
		public string Name { get; }
		public string Value { get; }
		public CityBonus( string name, string value )
		{
			Name = name;
			Value = value;
		}
	}

	List<CityBonus> CityBonusLines
	{
		get
		{
			var parts = new List<CityBonus>();
			if ( !Loop.IsValid() || !Loop.City.IsValid() )
				return parts;

			var stats = Loop.City.Stats();
			if ( stats.BonusHealth > 0 )
				parts.Add( new CityBonus( "HP", $"+{stats.BonusHealth}" ) );
			if ( stats.BonusDamage > 0 )
				parts.Add( new CityBonus( "DMG", $"+{stats.BonusDamage}" ) );
			if ( stats.DashCooldownScale < 0.99f )
			{
				var faster = (int)MathF.Round( (1f - stats.DashCooldownScale) * 100f );
				parts.Add( new CityBonus( "DASH", $"-{faster}%" ) );
			}
			if ( stats.SlowUnlocked )
				parts.Add( new CityBonus( "SLOW", "ENABLED" ) );
			var cards = stats.OfferCount - GameSettings.City.MinOffers;
			if ( cards > 0 )
				parts.Add( new CityBonus( "CARDS", $"+{cards}" ) );
			return parts;
		}
	}

	string KindClass( BuildingKind kind ) => kind.ToString().ToLowerInvariant();

	string OrganArt( BuildingKind kind ) => kind switch
	{
		BuildingKind.Infirmary => "ui/Arena UI/heart.png",
		BuildingKind.Anvil => "ui/Arena UI/muscle.png",
		BuildingKind.Booster => "ui/Arena UI/adrenal.png",
		BuildingKind.Brake => "ui/Arena UI/lungs.png",
		_ => "ui/Arena UI/liver.png"
	};

	string ExtractBank( int stash ) => stash == 1
		? GameSettings.Text.F( GameSettings.Text.Decide.ExtractBankOne, stash )
		: GameSettings.Text.F( GameSettings.Text.Decide.ExtractBankMany, stash );

	List<StatLine> OfferStats( RoundTrait trait, bool bought )
	{
		var level = TraitLevel( trait );
		var rank = bought ? Math.Max( 1, level ) : Math.Min( RoundTraits.MaxLevel( trait ), level + 1 );
		return StatSheet.Effects( trait, rank );
	}

	string OfferBlurb( RoundTrait trait, bool bought )
	{
		var text = RoundTraits.Blurb( trait );
		if ( string.IsNullOrWhiteSpace( text ) )
			return "";

		if ( RoundTraits.OneShot( trait ) )
			return text;

		var level = TraitLevel( trait );
		var shown = bought ? Math.Max( 1, level ) : Math.Min( RoundTraits.MaxLevel( trait ), level + 1 );
		return GameSettings.Text.F( GameSettings.Text.Shop.OfferBlurb, text, shown );
	}

	RoundTrait? ShopPreview
	{
		get
		{
			if ( !Loop.IsValid() || Loop.Phase != RunPhase.PickTrait )
				return null;

			if ( shopHover < 0 || shopHover >= Loop.Offers.Count )
				return null;

			var offer = Loop.Offers[shopHover];
			if ( offer.Bought || Loop.TraitLocked( offer.Trait ) )
				return null;

			return offer.Trait;
		}
	}

	List<SheetRow> ShopWeapon => StatSheet.Weapon( Loop, ShopPreview );
	List<SheetRow> ShopHero => StatSheet.Hero( Loop );

	string OfferCost( RoundTrait trait, bool bought )
	{
		if ( bought )
			return GameSettings.Text.Shop.Bought;

		if ( Loop.IsValid() && Loop.TraitLocked( trait ) )
			return GameSettings.Text.Shop.Locked;

		if ( !Loop.IsValid() )
			return "";

		return GameSettings.Text.F( GameSettings.Text.Shop.Cost, Loop.PriceOf( trait ) );
	}

	string RefreshClass => Loop.IsValid() && Loop.Scrap < Loop.ShopRefreshCost ? "poor" : "";

	string OfferClass( RoundTrait trait, bool bought )
	{
		if ( bought )
			return "upgrade bought";

		if ( Loop.IsValid() && Loop.TraitLocked( trait ) )
			return "upgrade poor locked";

		if ( Loop.IsValid() && Loop.Scrap < Loop.PriceOf( trait ) )
			return "upgrade poor";

		return "upgrade";
	}

	string TraitBorder( RoundTrait trait )
	{
		var c = RoundTraits.Color( trait );
		return $"rgba({(int)(c.r * 255)},{(int)(c.g * 255)},{(int)(c.b * 255)}, 0.85)";
	}

	string TraitInk( RoundTrait trait )
	{
		var c = RoundTraits.Color( trait );
		const float dull = 0.62f;
		return $"rgb({(int)(c.r * dull * 255)},{(int)(c.g * dull * 255)},{(int)(c.b * dull * 255)})";
	}

	float auraX;
	float auraY;
	float trailX;
	float trailY;
	Sandbox.UI.Panel auraPanel;
	Sandbox.UI.Panel trailPanel;
	Sandbox.UI.Panel shotCursor;
	readonly List<Sandbox.UI.Panel> reloadMarks = new();
	bool reloadLaidOut;
	const int ReloadMarks = 24;
	Sandbox.UI.Panel trayPanel;
	Sandbox.UI.Panel shopSheet;
	Sandbox.UI.Panel healthPanel;
	Sandbox.UI.Panel dashSlot;
	Sandbox.UI.Panel hotCard;
	int shopHover = -1;
	const float TrayArtWidth = 2544f;
	const float TrayArtHeight = 286f;
	const float ChargeMeterWidth = 131f;
	const float ChargeMeterHeight = 24f;

	float OrganLift
	{
		get
		{
			var width = Panel?.Box.Rect.Width ?? 0f;
			if ( width <= 1f )
				width = 1920f;

			return width * (198f / 2544f) + 48f;
		}
	}

	void TickTraySize()
	{
		if ( Panel is null )
			return;

		PlaceHealthIcons();
		PlaceChargeMeters();

		if ( !trayPanel.IsValid() )
			trayPanel = FindHud( "tray-back" );

		if ( !trayPanel.IsValid() )
			return;

		var width = Panel.Box.Rect.Width;
		var screenH = Panel.Box.Rect.Height;
		if ( width <= 1f || screenH <= 1f )
			return;

		var height = width * (TrayArtHeight / TrayArtWidth);
		trayPanel.Style.Position = Sandbox.UI.PositionMode.Absolute;
		trayPanel.Style.Left = Sandbox.UI.Length.Pixels( 0 );
		trayPanel.Style.Top = Sandbox.UI.Length.Auto;
		trayPanel.Style.Bottom = Sandbox.UI.Length.Pixels( 0 );
		trayPanel.Style.Width = Sandbox.UI.Length.Pixels( width );
		trayPanel.Style.Height = Sandbox.UI.Length.Pixels( height );
		trayPanel.Style.Dirty();

		if ( !shopSheet.IsValid() )
			shopSheet = FindHud( "shop-sheet" );

		if ( shopSheet.IsValid() )
		{
			shopSheet.Style.Bottom = Sandbox.UI.Length.Pixels( height + 16f );
			shopSheet.Style.Dirty();
		}
	}

	void PlaceHealthIcons()
	{
		if ( !healthPanel.IsValid() )
			healthPanel = FindHud( "health-slot" );

		if ( !healthPanel.IsValid() )
			return;

		var slotH = healthPanel.Box.Rect.Height;
		if ( slotH <= 1f )
			return;

		var iconH = MathF.Max( 8f, (slotH * 0.9f - 4f) / 2f );
		var iconW = iconH * (30f / 39f);
		foreach ( var child in healthPanel.Descendants )
		{
			if ( !child.HasClass( "hp" ) )
				continue;

			child.Style.Width = Sandbox.UI.Length.Pixels( iconW );
			child.Style.Height = Sandbox.UI.Length.Pixels( iconH );
			child.Style.Dirty();
		}
	}

	void PlaceChargeMeters()
	{
		if ( !dashSlot.IsValid() )
			dashSlot = FindHud( "dash-slot" );

		if ( !dashSlot.IsValid() )
			return;

		foreach ( var meter in dashSlot.Descendants )
		{
			if ( !meter.HasClass( "charge-meter" ) )
				continue;

			var fraction = meter.HasClass( "slow" )
				? Math.Clamp( SlowPercent / 100f, 0f, 1f )
				: Math.Clamp( DashPercent / 100f, 0f, 1f );
			var revealW = fraction >= 0.999f ? ChargeMeterWidth : ChargeMeterWidth * fraction;

			foreach ( var layer in meter.Descendants )
			{
				if ( layer.HasClass( "charge-layer" ) )
				{
					layer.Style.Width = Sandbox.UI.Length.Pixels( ChargeMeterWidth );
					layer.Style.Height = Sandbox.UI.Length.Pixels( ChargeMeterHeight );
					layer.Style.Left = Sandbox.UI.Length.Pixels( 0 );
					layer.Style.Top = Sandbox.UI.Length.Pixels( 0 );
					layer.Style.Dirty();
				}

				if ( layer.HasClass( "charge-reveal" ) )
				{
					layer.Style.Left = Sandbox.UI.Length.Pixels( 0 );
					layer.Style.Top = Sandbox.UI.Length.Pixels( 0 );
					layer.Style.Width = Sandbox.UI.Length.Pixels( revealW );
					layer.Style.Height = Sandbox.UI.Length.Pixels( ChargeMeterHeight );
					layer.Style.Dirty();
				}
			}
		}
	}

	void TickCursor()
	{
		var show = Loop.IsValid() && Loop.WantsUiCursor;

		if ( !auraPanel.IsValid() )
			auraPanel = FindHud( "cursor-aura" );
		if ( !trailPanel.IsValid() )
			trailPanel = FindHud( "cursor-trail" );

		var want = CursorOn();
		var snap = !show || (trailX == 0f && trailY == 0f);
		var drag = MathF.Min( 1f, Time.Delta * 9f );

		auraX = want.x;
		auraY = want.y;

		if ( snap )
		{
			trailX = want.x;
			trailY = want.y;
		}
		else
		{
			trailX = MathX.Lerp( trailX, want.x, drag );
			trailY = MathX.Lerp( trailY, want.y, drag );
		}

		PlaceCursor( auraPanel, auraX, auraY, show );
		PlaceCursor( trailPanel, trailX, trailY, show );
	}

	Vector2 CursorOn()
	{
		var origin = Panel;
		if ( origin is null )
			return Vector2.Zero;

		var scale = origin.ScaleFromScreen;
		if ( scale <= 0.0001f )
			scale = 1f;

		return Mouse.Position * scale;
	}

	Sandbox.UI.Panel FindHud( string className )
	{
		if ( Panel is null )
			return null;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( className ) )
				return child;
		}

		return null;
	}

	static void PlaceCursor( Sandbox.UI.Panel target, float x, float y, bool show )
	{
		if ( !target.IsValid() )
			return;

		target.SetClass( "on", show );
		target.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
		target.Style.Left = Sandbox.UI.Length.Pixels( x );
		target.Style.Top = Sandbox.UI.Length.Pixels( y );
		target.Style.Dirty();
	}

	void TickReloadCursor()
	{
		if ( !shotCursor.IsValid() || reloadMarks.Count != ReloadMarks )
			BindReloadMarks();

		var show = ShowReloadCursor();
		var point = CursorOn();
		PlaceCursor( shotCursor, point.x, point.y, show );
		if ( !show || reloadMarks.Count == 0 )
			return;

		if ( !reloadLaidOut )
			LayoutReloadMarks();

		var amount = Loop.Inventory.Reload01;
		for ( var i = 0; i < reloadMarks.Count; i++ )
			reloadMarks[i].SetClass( "on", amount * reloadMarks.Count >= i + 0.001f );
	}

	bool ShowReloadCursor()
	{
		if ( !Loop.IsValid() || !Loop.Inventory.IsValid() )
			return false;

		if ( Loop.InCity || Loop.InMenu || Loop.WantsUiCursor )
			return false;

		return Loop.Inventory.ReloadLeft > 0.02f;
	}

	void BindReloadMarks()
	{
		shotCursor = FindHud( "shot-cursor" );
		reloadMarks.Clear();
		reloadLaidOut = false;
		if ( Panel is null )
			return;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( "reload-mark" ) )
				reloadMarks.Add( child );
		}
	}

	void LayoutReloadMarks()
	{
		var count = reloadMarks.Count;
		if ( count == 0 )
			return;

		const float center = 32f;
		const float radius = 24f;
		for ( var i = 0; i < count; i++ )
		{
			var ang = -MathF.PI * 0.5f + MathF.Tau * i / count;
			var mark = reloadMarks[i];
			mark.Style.Position = Sandbox.UI.PositionMode.Absolute;
			mark.Style.Left = Sandbox.UI.Length.Pixels( center + MathF.Cos( ang ) * radius );
			mark.Style.Top = Sandbox.UI.Length.Pixels( center + MathF.Sin( ang ) * radius );
			mark.Style.Dirty();
		}

		reloadLaidOut = true;
	}

	void TickHover()
	{
		if ( Panel is null || !Loop.IsValid() || !Loop.WantsUiCursor )
		{
			ClearHover();
			return;
		}

		Sandbox.UI.Panel over = null;
		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasHovered )
				over = child;
		}

		var card = over;
		while ( card.IsValid() && !card.HasClass( "card" ) )
			card = card.Parent;

		var picking = false;
		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "card" ) )
				continue;

			var on = child == card;
			if ( child.HasClass( "hot" ) != on )
				child.SetClass( "hot", on );

			if ( on )
				picking = true;
		}

		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "overlay" ) )
				continue;

			child.SetClass( "picking", picking && child.HasClass( "menu" ) );
		}

		if ( card.IsValid() && card != hotCard && (hotCard is null || hotCard.IsValid()) )
			ArenaSounds.MenuMove();

		hotCard = card.IsValid() ? card : null;
	}

	void ClearHover()
	{
		if ( Panel is null )
			return;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( "hot" ) )
				child.SetClass( "hot", false );
			if ( child.HasClass( "picking" ) )
				child.SetClass( "picking", false );
		}

		hotCard = null;
	}

	protected override int BuildHash()
	{
		if ( !Loop.IsValid() )
			return 0;

		var menu = Loop.InMenu;
		var city = Loop.InCity;
		var shop = Loop.Phase == RunPhase.PickTrait;
		var saves = menu && Loop.MenuView == MenuPage.Saves;
		var boss = Loop.InBossFight;
		var mag = Loop.Inventory.IsValid() ? Loop.Inventory.MagLoaded : 0;

		var a = System.HashCode.Combine(
			Loop.Lap,
			Loop.Health,
			(int)Loop.Phase,
			Loop.Stash,
			Loop.Scrap,
			Loop.Kills,
			mag,
			Loop.HurtAmount > 0.01f );

		var b = System.HashCode.Combine(
			Loop.Notice,
			Loop.NoticeVisible,
			TimeText,
			Loop.Paused,
			(int)Loop.MenuView,
			(int)Loop.MenuFocus,
			(int)Loop.SettingCursor,
			(int)UserSettings.Graphics );

		var c = System.HashCode.Combine(
			boss ? Loop.BossHealth : 0,
			Loop.HasBossOffer,
			boss,
			Loop.CanPause,
			(int)Loop.Location,
			Loop.BestLine,
			Loop.FedBiomass,
			Loop.TaskDone );

		var d = System.HashCode.Combine(
			Loop.TaskStamp,
			Loop.HasTask,
			Loop.HasNextRing,
			Loop.BestExtract,
			Loop.ExtractedRounds,
			Loop.BurnedRounds,
			Loop.ShotsFired,
			shopHover );

		var e = saves
			? System.HashCode.Combine( Loop.SlotBlurb( 0 ), Loop.SlotBlurb( 1 ), Loop.SlotBlurb( 2 ), Loop.SlotExists( 0 ), Loop.SlotExists( 1 ), Loop.SlotExists( 2 ), Loop.ActiveSlot, Loop.SaveCursor )
			: System.HashCode.Combine( Loop.ActiveSlot, Loop.SaveCursor );

		var f = city && Loop.City.IsValid()
			? System.HashCode.Combine( Loop.City.Warehouse, (int)Loop.City.Selected, Loop.City.PlacementFacing, (int)Loop.City.Mode, string.Join( "|", CityBonusLines.Select( line => line.Name + line.Value ) ), Buildings.Blurb( Loop.City.Selected ), Buildings.Promise( Loop.City.Selected ) + Buildings.FrameCost( Loop.City.Selected, Loop.City.Placed( Loop.City.Selected ) ) )
			: 0;

		var g = shop
			? System.HashCode.Combine( Loop.Offers.Count, Loop.OfferStamp, Loop.ShopHasBundle, Loop.ShopCanBuyAll, Loop.ShopBuyAllCost, Loop.ShopRefreshCost )
			: 0;

		var h = System.HashCode.Combine(
			menu && Loop.City.IsValid() ? Loop.OrganCount : 0,
			menu ? UserSettings.Steps( SettingRow.Music ) : 0,
			menu ? UserSettings.Steps( SettingRow.Sfx ) : 0,
			menu ? UserSettings.Steps( SettingRow.Shake ) : 0,
			(int)OrganLift,
			Loop.Ascend );

		return System.HashCode.Combine( a, b, c, d, e, f, g, h );
	}
}

