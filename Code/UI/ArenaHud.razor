@namespace LoopedLoaded
@inherits PanelComponent

<root>
	<div class="hud">

		<div class="notice @(Loop.NoticeVisible && !Loop.InMenu ? "on" : "off") @(Loop.HurtAmount > 0.2f ? "hurt" : "")">
			<label>@Loop.Notice</label>
		</div>

		@if ( !Loop.InCity && !Loop.InMenu && Loop.HurtAmount > 0.01f )
		{
			<div class="hurt-veil" style="opacity: @HurtVeil"></div>
			<div class="hurt-stamp">
				<label>-1</label>
			</div>
		}

		@if ( !Loop.InCity && !Loop.InMenu && Loop.Inventory.IsValid() )
		{
			<div class="top-left">
				<div class="lap-chip">
					<label class="key">@(Loop.InBossFight ? "CORE" : "LAP")</label>
					<label class="value">@(Loop.InBossFight ? Loop.BossHealth : Loop.Lap)</label>
				</div>
				<div class="meter">
					<div class="fill lap @(Loop.InBossFight ? "boss" : "")" style="width: @(Loop.InBossFight ? BossPercent : LapPercent)%"></div>
				</div>
				<div class="hearts">
					@for ( var i = 0; i < Loop.HeartMax; i++ )
					{
						<div class="heart @(i < Loop.Health ? "live" : "dead") @(i < Loop.Health && Loop.HurtAmount > 0.08f ? "sting" : "")"></div>
					}
				</div>
				<label class="clock">@TimeText</label>
				<label class="mods">@GlobalMods</label>
			</div>

			<div class="top-right">
				<div class="stat"><label class="key">STASH</label><label class="value">@Loop.Stash</label></div>
				<div class="stat"><label class="key">BEST</label><label class="value">@Loop.BestExtract</label></div>
				<div class="stat"><label class="key">KILLS</label><label class="value">@Loop.Kills</label></div>
				<div class="stat"><label class="key">CAUGHT</label><label class="value">@Loop.Catches</label></div>
			</div>

			<div class="bottom">
				<div class="slots">
					@foreach ( var slot in Loop.Inventory.Slots )
					{
						<div class="slot @StatusClass(slot) @(slot.Index == Loop.Inventory.SelectedIndex ? "selected" : "")">
							<div class="pip" style="background-color: @PipColor(slot)"></div>
							<label class="idx">@(slot.Index + 1)</label>
						</div>
					}
				</div>

				<div class="meters">
					<div class="dash">
						<label class="key">DASH</label>
						<div class="meter">
							<div class="fill dash @(DashReady ? "ready" : "")" style="width: @(DashPercent)%"></div>
						</div>
					</div>
					@if ( SlowUnlocked )
					{
						<div class="dash">
							<label class="key">SLOW</label>
							<div class="meter">
								<div class="fill slow @(Slowing ? "on" : "")" style="width: @(SlowPercent)%"></div>
							</div>
						</div>
					}
				</div>
			</div>
		}

		@if ( Loop.InCity && Loop.City.IsValid() )
		{
			<div class="city">
				<div class="top-left">
					<div class="lap-chip">
						<label class="key">@Loop.City.Mode</label>
						<label class="value">WH @Loop.City.Warehouse</label>
					</div>
					<label class="mods">@Loop.City.HoverText()</label>
					<label class="clock">@CityBonuses</label>
				</div>
				<div class="bottom">
					@if ( Loop.City.Building )
					{
						<div class="blueprint">
							<div class="glyph @KindClass(Loop.City.Selected)">
								<div class="a"></div>
								<div class="b"></div>
								<div class="c"></div>
							</div>
							<div class="copy">
								<label class="title">@Buildings.Title(Loop.City.Selected)</label>
								<label class="payoff">@Buildings.Promise(Loop.City.Selected)</label>
								<label class="blurb">@Buildings.Blurb(Loop.City.Selected)</label>
								<label class="cost">FRAME  ·  @Buildings.FirstCost(Loop.City.Selected) HITS TO WORK</label>
							</div>
							<div class="promise">
								@if ( Loop.City.Selected == BuildingKind.Infirmary )
								{
									<div class="hearts">
										<div class="heart live"></div>
										<div class="heart live"></div>
										<div class="heart live"></div>
										<div class="heart add"></div>
									</div>
									<label class="tag">+1 HP</label>
								}
								else
								{
									@if ( Loop.City.Selected == BuildingKind.Anvil )
									{
										<div class="shots">
											<div class="shot"></div>
											<div class="shot"></div>
											<div class="shot big"></div>
										</div>
										<label class="tag">+1 DMG</label>
									}
									else
									{
										@if ( Loop.City.Selected == BuildingKind.Booster )
										{
											<div class="compare">
												<div class="dash">
													<label class="key">NOW</label>
													<div class="meter"><div class="fill dash" style="width: 100%"></div></div>
												</div>
												<div class="dash">
													<label class="key">THEN</label>
													<div class="meter"><div class="fill dash ready" style="width: 86%"></div></div>
												</div>
											</div>
										}
										else
										{
											@if ( Loop.City.Selected == BuildingKind.Brake )
											{
												<div class="dash">
													<label class="key">SLOW</label>
													<div class="meter"><div class="fill slow on" style="width: 100%"></div></div>
												</div>
												<label class="tag">UNLOCKS</label>
											}
											else
											{
												<div class="mini-cards">
													<div class="mini-card"></div>
													<div class="mini-card"></div>
													<div class="mini-card add"></div>
												</div>
												<label class="tag">+1 CARD</label>
											}
										}
									}
								}
							</div>
						</div>
					}
					<div class="slots">
						@foreach ( var kind in Buildings.All )
						{
							<div class="slot @(kind == Loop.City.Selected ? "selected chambered" : "") @(Loop.City.Building ? "" : "idle")">
								<div class="glyph @KindClass(kind)">
									<div class="a"></div>
									<div class="b"></div>
									<div class="c"></div>
								</div>
								<div class="text">
									<label class="name">@((int)kind + 1)  @Buildings.Title(kind)</label>
									<label class="idx">@Buildings.Payoff(kind)</label>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		}

		<label class="help">@HelpText</label>

		@if ( Loop.CanPause )
		{
			<div class="pause-btn" onclick="@HitPause">
				<div class="pause-glyph">
					<div class="pause-bar"></div>
					<div class="pause-bar"></div>
				</div>
				<label>PAUSE</label>
			</div>
		}

		@if ( Loop.Paused )
		{
			<div class="overlay menu">
				<label class="kicker">PAUSED</label>
				<label class="overlay-title">ONE ROUND TRIP</label>
				<label class="blurb">The ring holds. Trajectories wait.</label>
				<div class="cards">
					<div class="card" onclick="@Resume">
						<label class="key">1</label>
						<label class="title">RESUME</label>
						<label class="blurb">Back to the lap. Nothing moved.</label>
					</div>
					<div class="card" onclick="@PauseToMenu">
						<label class="key">2</label>
						<label class="title">MENU</label>
						<label class="blurb">Leave the run. City stays.</label>
					</div>
					<div class="card" onclick="@QuitGame">
						<label class="key">3</label>
						<label class="title">QUIT</label>
						<label class="blurb">Close the game.</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Title )
		{
			<div class="overlay menu">
				<label class="kicker">ONE MORE LAP</label>
				<label class="overlay-title">ONE ROUND TRIP</label>
				<label class="blurb">Aim. Fire. Catch it back. Cash out to the city — or greed another lap.</label>
				<label class="blurb">SLOT @(Loop.ActiveSlot + 1)@(Loop.HasActiveSave ? $"  ·  {Loop.SlotBlurb(Loop.ActiveSlot)}" : "  ·  NEW")</label>
				<div class="cards">
					<div class="card" onclick="@StartRun">
						<label class="key">1</label>
						<label class="title">@(Loop.HasActiveSave ? "CONTINUE" : "PLAY")</label>
						<label class="blurb">@(Loop.HasActiveSave ? "Run with this city's warehouse and buildings." : "Start a run with one round. Extract or go again.")</label>
					</div>
					<div class="card" onclick="@OpenCity">
						<label class="key">2</label>
						<label class="title">CITY</label>
						<label class="blurb">Build frames and spend warehouse ammo.</label>
					</div>
					<div class="card" onclick="@OpenSaves">
						<label class="key">3</label>
						<label class="title">SAVES</label>
						<label class="blurb">Autosave slots. Load or delete a city.</label>
					</div>
				</div>
			</div>
		}

		@if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Saves )
		{
			<div class="overlay menu">
				<label class="kicker">AUTOSAVE</label>
				<label class="overlay-title">SAVES</label>
				<label class="blurb">City writes itself. Pick a slot, then load or delete.</label>
				<div class="cards">
					<div class="card @(Loop.SaveCursor == 0 ? "selected" : "")" onclick="@HighlightSlot1">
						<label class="key">1</label>
						<label class="title">SLOT 1</label>
						<label class="blurb">@Loop.SlotBlurb(0)</label>
					</div>
					<div class="card @(Loop.SaveCursor == 1 ? "selected" : "")" onclick="@HighlightSlot2">
						<label class="key">2</label>
						<label class="title">SLOT 2</label>
						<label class="blurb">@Loop.SlotBlurb(1)</label>
					</div>
					<div class="card @(Loop.SaveCursor == 2 ? "selected" : "")" onclick="@HighlightSlot3">
						<label class="key">3</label>
						<label class="title">SLOT 3</label>
						<label class="blurb">@Loop.SlotBlurb(2)</label>
					</div>
				</div>
				<div class="cards">
					<div class="card" onclick="@LoadHighlighted">
						<label class="key">SPACE</label>
						<label class="title">LOAD SLOT @(Loop.SaveCursor + 1)</label>
						<label class="blurb">@(Loop.SlotInfo(Loop.SaveCursor) is not null && Loop.SlotInfo(Loop.SaveCursor).HasProgress ? "Use this city." : "Empty slot. Fresh city.")</label>
					</div>
					@if ( Loop.SlotExists( Loop.SaveCursor ) )
					{
						<div class="card" onclick="@DeleteHighlighted">
							<label class="key">R</label>
							<label class="title">DELETE SLOT @(Loop.SaveCursor + 1)</label>
							<label class="blurb">Wipe this city. Cannot undo.</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.DecideLap )
		{
			<div class="overlay choose">
				<label class="overlay-title">LAP @Loop.Lap CLEAR</label>
				<label class="blurb">STASH @Loop.Stash  ·  TAKE IT HOME OR RISK ANOTHER</label>
				<div class="cards">
					<div class="card" onclick="@ChooseExtract">
						<label class="key">1</label>
						<label class="title">EXTRACT</label>
						<label class="blurb">Bank @Loop.Stash round@(Loop.Stash == 1 ? "" : "s"). Return to the city.</label>
					</div>
					<div class="card" onclick="@ChooseContinue">
						<label class="key">2</label>
						<label class="title">ONE MORE LAP</label>
						<label class="blurb">Stay on the ring. It gets harder.</label>
					</div>
					@if ( Loop.HasBossOffer )
					{
						<div class="card" onclick="@ChooseBoss">
							<label class="key">3</label>
							<label class="title">FIGHT THE CORE</label>
							<label class="blurb">Ricochet the nucleus. Win: stash ×2, then city.</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.PickTrait )
		{
			<div class="overlay choose">
				<label class="overlay-title">UPGRADE ALL ROUNDS</label>
				<div class="cards">
					<div class="card upgrade" style="border-color: @TraitBorder(Loop.OfferA)" onclick="@PickOfferA">
						<label class="key">1</label>
						<label class="title">@RoundTraits.Title(Loop.OfferA)</label>
						<label class="blurb">@OfferBlurb(Loop.OfferA)</label>
					</div>
					<div class="card upgrade" style="border-color: @TraitBorder(Loop.OfferB)" onclick="@PickOfferB">
						<label class="key">2</label>
						<label class="title">@RoundTraits.Title(Loop.OfferB)</label>
						<label class="blurb">@OfferBlurb(Loop.OfferB)</label>
					</div>
					@if ( Loop.HasThirdOffer )
					{
						<div class="card upgrade" style="border-color: @TraitBorder(Loop.OfferC)" onclick="@PickOfferC">
							<label class="key">3</label>
							<label class="title">@RoundTraits.Title(Loop.OfferC)</label>
							<label class="blurb">@OfferBlurb(Loop.OfferC)</label>
						</div>
					}
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Dead )
		{
			<div class="overlay choose">
				<label class="overlay-title">RUN OVER</label>
				<label class="blurb">@Loop.BurnedRounds ROUND@(Loop.BurnedRounds == 1 ? "" : "S") BURNED</label>
				<div class="cards">
					<div class="card" onclick="@GoCity">
						<label class="key">R</label>
						<label class="title">CITY</label>
						<label class="blurb">Leave the ring. Build with what you already banked.</label>
					</div>
				</div>
			</div>
		}

		@if ( !Loop.Paused && Loop.Phase == RunPhase.Extracted )
		{
			<div class="overlay choose">
				<label class="overlay-title">EXTRACTED</label>
				<label class="blurb">@Loop.ExtractedRounds ROUND@(Loop.ExtractedRounds == 1 ? "" : "S") BANKED  ·  BEST @Loop.BestExtract</label>
				<div class="cards">
					<div class="card" onclick="@GoCity">
						<label class="key">R</label>
						<label class="title">CITY</label>
						<label class="blurb">Return to construction.</label>
					</div>
				</div>
			</div>
		}

	</div>

	<div class="cursor-trail"></div>
	<div class="cursor-aura">
		<div class="cursor-ring"></div>
		<div class="cursor-dot"></div>
	</div>
</root>

@code
{
	public GameLoop Loop { get; set; }

	protected override void OnTreeFirstBuilt()
	{
		Panel.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
	}

	protected override void OnUpdate()
	{
		if ( Panel is null || !Loop.IsValid() )
			return;

		Panel.Style.PointerEvents = Loop.WantsUiCursor || Loop.CanPause
			? Sandbox.UI.PointerEvents.All
			: Sandbox.UI.PointerEvents.None;

		TickCursor();
		TickHover();
	}

	void Resume() => Loop?.Resume();
	void HitPause()
	{
		Loop?.NoteUiClick();
		Loop?.Pause();
	}
	void PauseToMenu() => Loop?.ShowMenu();
	void StartRun() => Loop?.Restart();
	void OpenCity() => Loop?.OpenCityFromMenu();
	void OpenSaves() => Loop?.OpenSaves();
	void HighlightSlot1() => Loop?.HighlightSave( 0 );
	void HighlightSlot2() => Loop?.HighlightSave( 1 );
	void HighlightSlot3() => Loop?.HighlightSave( 2 );
	void LoadHighlighted() => Loop?.UseSave( Loop.SaveCursor );
	void DeleteHighlighted() => Loop?.DeleteSave( Loop.SaveCursor );
	void QuitGame() => Loop?.QuitGame();
	void ChooseExtract() => Loop?.ChooseExtract();
	void ChooseContinue() => Loop?.ChooseContinue();
	void ChooseBoss() => Loop?.ChooseBoss();
	void PickOfferA() => Loop?.ChooseUpgrade( Loop.OfferA );
	void PickOfferB() => Loop?.ChooseUpgrade( Loop.OfferB );
	void PickOfferC() => Loop?.ChooseUpgrade( Loop.OfferC );
	void GoCity() => Loop?.ChooseCity();

	int LapPercent => Loop.IsValid() ? (int)(Loop.LapFraction * 100f) : 0;
	int BossPercent => Loop.IsValid() && Loop.BossMaxHealth > 0 ? (int)(Loop.BossHealth / (float)Loop.BossMaxHealth * 100f) : 0;
	int HurtPercent => Loop.IsValid() ? (int)(Loop.HurtAmount * 100f) : 0;
	string HurtVeil => (Loop.IsValid() ? Loop.HurtAmount * 0.55f : 0f).ToString( "0.###" );
	int DashPercent => Runner.IsValid() ? (int)(Runner.DashCharge * 100f) : 0;
	int SlowPercent => Runner.IsValid() ? (int)(Runner.SlowCharge * 100f) : 0;
	bool DashReady => Runner.IsValid() && Runner.DashCharge >= 1f;
	bool SlowUnlocked => Runner.IsValid() && Runner.SlowUnlocked;
	bool Slowing => Runner.IsValid() && Runner.Slowing;
	RingRunner Runner => Loop.IsValid() ? Loop.Runner : null;

	string TimeText
	{
		get
		{
			if ( !Loop.IsValid() ) return "0:00";
			var total = (int)Loop.RunTime;
			return $"{total / 60}:{total % 60:00}";
		}
	}

	string GlobalMods
	{
		get
		{
			if ( !Loop.IsValid() || !Loop.Inventory.IsValid() ) return "PLAIN";
			var parts = new List<string>();
			foreach ( var trait in RoundTraits.All )
			{
				var level = Loop.Inventory.Loadout.TraitLevel( trait );
				if ( level > 0 )
					parts.Add( $"{RoundTraits.Code( trait )}{level}" );
			}

			var body = parts.Count == 0 ? "PLAIN" : string.Join( "  ", parts );
			if ( Loop.BloodShields > 0 )
				body += $"  SH{Loop.BloodShields}";

			return $"{body}  ×{Loop.Threat:0.00}";
		}
	}

	string HelpText
	{
		get
		{
			if ( !Loop.IsValid() )
				return "";

			if ( Loop.Paused )
				return "1 RESUME  ·  2 MENU  ·  3 QUIT";

			if ( Loop.Phase == RunPhase.Menu && Loop.MenuView == MenuPage.Saves )
				return "1-3 SELECT  ·  SPACE LOAD  ·  R DELETE  ·  ESC BACK";

			return Loop.Phase switch
			{
				RunPhase.Menu => "1 PLAY  ·  2 CITY  ·  3 SAVES  ·  ESC QUIT",
				RunPhase.City => Loop.City.IsValid() && Loop.City.Building
					? "LMB PLACE/REMOVE  ·  WHEEL ROTATE  ·  1-5 TYPE  ·  E SHOOT  ·  SPACE/R RUN  ·  ESC PAUSE"
					: "LMB FIRE  ·  E BUILD  ·  1-5 TYPE  ·  SPACE/R RUN  ·  ESC PAUSE",
				RunPhase.DecideLap => Loop.HasBossOffer ? "CLICK  ·  1 CITY  ·  2 STAY  ·  3 FIGHT THE CORE  ·  ESC PAUSE" : "CLICK  ·  1 CITY  ·  2 STAY  ·  ESC PAUSE",
				RunPhase.PickTrait => Loop.HasThirdOffer ? "CLICK A CARD  ·  1 / 2 / 3  ·  ESC PAUSE" : "CLICK A CARD  ·  1 / 2  ·  ESC PAUSE",
				RunPhase.Dead or RunPhase.Extracted => "CLICK CITY  ·  R CITY  ·  ESC MENU",
				_ => Loop.InBossFight
					? "RICOCHET TO BREAK THE CORE  ·  SPACE DASH  ·  R RESTART  ·  ESC PAUSE"
					: Loop.CanSkipLap
						? "E SKIP LAP  ·  LMB FIRE  ·  SPACE DASH  ·  R RESTART  ·  ESC PAUSE"
						: "MOUSE AIM · LMB FIRE · 1-9 ROUNDS · SPACE DASH · R RESTART  ·  ESC PAUSE"
			};
		}
	}

	string CityBonuses
	{
		get
		{
			if ( !Loop.IsValid() || !Loop.City.IsValid() )
				return "NO BONUSES YET";

			var stats = Loop.City.Stats();
			var parts = new List<string>();
			if ( stats.BonusHealth > 0 ) parts.Add( $"HP+{stats.BonusHealth}" );
			if ( stats.BonusDamage > 0 ) parts.Add( $"DMG+{stats.BonusDamage}" );
			if ( stats.DashCooldownScale < 0.99f ) parts.Add( "DASH" );
			if ( stats.SlowUnlocked ) parts.Add( "SLOW" );
			if ( stats.OfferCount >= 3 ) parts.Add( "3 CARDS" );
			return parts.Count == 0 ? "NO BONUSES YET" : string.Join( "  ", parts );
		}
	}

	string KindClass( BuildingKind kind ) => kind.ToString().ToLowerInvariant();

	string StatusClass( RoundSlot slot ) => slot.Status.ToString().ToLower();

	string OfferBlurb( RoundTrait trait )
	{
		var next = Loop.Inventory.Loadout.TraitLevel( trait ) + 1;
		if ( next > 3 ) next = 3;
		return $"{RoundTraits.Blurb( trait )}  LV{next}";
	}

	string PipColor( RoundSlot slot )
	{
		var c = slot.Tint;
		return $"rgb({(int)(c.r * 255)},{(int)(c.g * 255)},{(int)(c.b * 255)})";
	}

	string TraitBorder( RoundTrait trait )
	{
		var c = RoundTraits.Color( trait );
		return $"rgba({(int)(c.r * 255)},{(int)(c.g * 255)},{(int)(c.b * 255)}, 0.85)";
	}

	float auraX;
	float auraY;
	float trailX;
	float trailY;
	Sandbox.UI.Panel auraPanel;
	Sandbox.UI.Panel trailPanel;
	Sandbox.UI.Panel hotCard;

	void TickCursor()
	{
		var show = Loop.IsValid() && Loop.WantsUiCursor;

		if ( !auraPanel.IsValid() )
			auraPanel = FindHud( "cursor-aura" );
		if ( !trailPanel.IsValid() )
			trailPanel = FindHud( "cursor-trail" );

		var want = CursorOn();
		var snap = !show || (trailX == 0f && trailY == 0f);
		var drag = MathF.Min( 1f, Time.Delta * 9f );

		auraX = want.x;
		auraY = want.y;

		if ( snap )
		{
			trailX = want.x;
			trailY = want.y;
		}
		else
		{
			trailX = MathX.Lerp( trailX, want.x, drag );
			trailY = MathX.Lerp( trailY, want.y, drag );
		}

		PlaceCursor( auraPanel, auraX, auraY, show );
		PlaceCursor( trailPanel, trailX, trailY, show );
	}

	Vector2 CursorOn()
	{
		var origin = Panel;
		if ( origin is null )
			return Vector2.Zero;

		var scale = origin.ScaleFromScreen;
		if ( scale <= 0.0001f )
			scale = 1f;

		return Mouse.Position * scale;
	}

	Sandbox.UI.Panel FindHud( string className )
	{
		if ( Panel is null )
			return null;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( className ) )
				return child;
		}

		return null;
	}

	static void PlaceCursor( Sandbox.UI.Panel target, float x, float y, bool show )
	{
		if ( !target.IsValid() )
			return;

		target.SetClass( "on", show );
		target.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
		target.Style.Left = Sandbox.UI.Length.Pixels( x );
		target.Style.Top = Sandbox.UI.Length.Pixels( y );
		target.Style.Dirty();
	}

	void TickHover()
	{
		if ( Panel is null || !Loop.IsValid() || !Loop.WantsUiCursor )
		{
			ClearHover();
			return;
		}

		Sandbox.UI.Panel over = null;
		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasHovered )
				over = child;
		}

		var card = over;
		while ( card.IsValid() && !card.HasClass( "card" ) )
			card = card.Parent;

		var picking = false;
		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "card" ) )
				continue;

			var on = child == card;
			if ( child.HasClass( "hot" ) != on )
				child.SetClass( "hot", on );

			if ( on )
				picking = true;
		}

		foreach ( var child in Panel.Descendants )
		{
			if ( !child.HasClass( "overlay" ) )
				continue;

			child.SetClass( "picking", picking && child.HasClass( "menu" ) );
		}

		if ( card.IsValid() && card != hotCard && (hotCard is null || hotCard.IsValid()) )
			Sound.Play( "sounds/kenney/ui/ui.navigate.forward.sound" );

		hotCard = card.IsValid() ? card : null;
	}

	void ClearHover()
	{
		if ( Panel is null )
			return;

		foreach ( var child in Panel.Descendants )
		{
			if ( child.HasClass( "hot" ) )
				child.SetClass( "hot", false );
			if ( child.HasClass( "picking" ) )
				child.SetClass( "picking", false );
		}

		hotCard = null;
	}

	protected override int BuildHash()
	{
		var a = System.HashCode.Combine(
			Loop.IsValid() ? Loop.Lap : 0,
			Loop.IsValid() ? Loop.Health : 0,
			Loop.IsValid() ? (int)Loop.Phase : 0,
			LapPercent,
			DashPercent,
			Loop.IsValid() ? Loop.Stash : 0,
			Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.SelectedIndex : 0,
			Loop.IsValid() && Loop.NoticeVisible );

		var b = System.HashCode.Combine(
			Loop.IsValid() ? Loop.Notice : "",
			TimeText,
			GlobalMods,
			Loop.IsValid() ? Loop.Kills : 0,
			Loop.IsValid() ? Loop.BestExtract : 0,
			Loop.IsValid() ? Loop.ExtractedRounds : 0,
			Loop.IsValid() ? Loop.BurnedRounds : 0,
			Loop.IsValid() && Loop.Inventory.IsValid() ? Loop.Inventory.Slots.Sum( s => s.StatusHash ) : 0 );

		var c = System.HashCode.Combine(
			Loop.IsValid() && Loop.City.IsValid() ? Loop.City.Warehouse : 0,
			Loop.IsValid() && Loop.City.IsValid() ? (int)Loop.City.Selected : 0,
			Loop.IsValid() && Loop.City.IsValid() ? Loop.City.HoverText() : "",
			Loop.IsValid() && Loop.HasThirdOffer,
			Loop.IsValid() ? Loop.HeartMax : 0,
			CityBonuses,
			HurtPercent,
			Loop.IsValid() && Loop.InBossFight );

		var d = System.HashCode.Combine(
			Loop.IsValid() ? Loop.BossHealth : 0,
			Loop.IsValid() && Loop.HasBossOffer,
			Loop.IsValid() && Loop.City.IsValid() ? Loop.City.PlacementFacing : 0,
			Loop.IsValid() && Loop.City.IsValid() ? (int)Loop.City.Mode : 0,
			Loop.IsValid() && Loop.Paused,
			Loop.IsValid() ? (int)Loop.MenuView : 0,
			Loop.IsValid() ? Loop.ActiveSlot : 0,
			Loop.IsValid() ? Loop.SaveCursor : 0 );

		var e = System.HashCode.Combine(
			Loop.IsValid() ? Loop.SlotBlurb( 0 ) : "",
			Loop.IsValid() ? Loop.SlotBlurb( 1 ) : "",
			Loop.IsValid() ? Loop.SlotBlurb( 2 ) : "",
			Loop.IsValid() && Loop.SlotExists( 0 ),
			Loop.IsValid() && Loop.SlotExists( 1 ),
			Loop.IsValid() && Loop.SlotExists( 2 ),
			Loop.IsValid() && Loop.CanSkipLap,
			Loop.IsValid() && Loop.CanPause );

		return System.HashCode.Combine( a, b, c, d, e );
	}
}

