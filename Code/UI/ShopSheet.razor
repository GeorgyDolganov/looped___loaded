@namespace LoopedLoaded
@inherits PanelComponent

<root class="shop-sheet @(Show ? "" : "off")">
	@if ( Show )
	{
		<img class="sheet-back" src="ui/Arena UI/element_back_long.png" />
		<div class="sheet-body">
			<label class="sheet-kicker">WEAPON</label>
			@foreach ( var row in WeaponRows )
			{
				<div class="sheet-row">
					<label class="key">@row.Label</label>
					<div class="vals">
						<label class="now">@row.Now</label>
						@if ( row.Next != "" )
						{
							<label class="arrow">→</label>
							<label class="next @row.NextClass">@row.Next</label>
						}
					</div>
				</div>
			}
			<label class="sheet-kicker">HERO</label>
			@foreach ( var row in HeroRows )
			{
				<div class="sheet-row">
					<label class="key">@row.Label</label>
					<div class="vals">
						<label class="now">@row.Now</label>
					</div>
				</div>
			}
		</div>
	}
</root>

@code
{
	[Property] public GameLoop Loop { get; set; }
	[Property] public ShopLook Look { get; set; }

	float placedBottom = -1f;

	bool Show => Loop.IsValid() && !Loop.Paused && Loop.Phase == RunPhase.PickTrait && Look is not null;

	TrinketDef Preview
	{
		get
		{
			if ( !Show || Look.Index < 0 || Look.Index >= Loop.Offers.Count )
				return null;

			var offer = Loop.Offers[Look.Index];
			if ( offer.Bought || Loop.TraitLocked( offer.Trait ) )
				return null;

			return offer.Trait;
		}
	}

	List<SheetRow> WeaponRows => StatSheet.Weapon( Loop, Preview );
	List<SheetRow> HeroRows => StatSheet.Hero( Loop );

	protected override void OnTreeFirstBuilt()
	{
		Panel.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
		Panel.Style.ZIndex = 40;
	}

	protected override void OnTreeBuilt()
	{
		ApplyBottom( true );
	}

	protected override void OnUpdate()
	{
		if ( !Show )
		{
			placedBottom = -1f;
			return;
		}

		ApplyBottom( false );
	}

	void ApplyBottom( bool force )
	{
		if ( Panel is null || Look is null || Look.Bottom < 0f )
			return;

		if ( !force && MathF.Abs( placedBottom - Look.Bottom ) < 0.5f )
			return;

		placedBottom = Look.Bottom;
		Panel.Style.Position = Sandbox.UI.PositionMode.Absolute;
		Panel.Style.Bottom = Sandbox.UI.Length.Pixels( Look.Bottom );
		Panel.Style.Dirty();
	}

	protected override int BuildHash()
	{
		if ( !Show )
			return 1;

		return System.HashCode.Combine( 2, Look.Index, Loop.OfferStamp );
	}
}

<style>
	.shop-sheet {
		position: absolute;
		right: 12px;
		width: 288px;
		aspect-ratio: 477 / 820;
		padding: 0px;
		background-color: transparent;
		border-width: 0px;
		border-radius: 0px;
		overflow: visible;
		pointer-events: none;
		z-index: 40;
	}

	.shop-sheet.off {
		display: none;
	}

	.sheet-back {
		position: absolute;
		left: 0px;
		top: 0px;
		width: 100%;
		height: 100%;
	}

	.sheet-body {
		position: absolute;
		z-index: 1;
		left: 13%;
		right: 13%;
		top: 8%;
		bottom: 7%;
		padding: 0px;
		flex-direction: column;
		align-items: stretch;
		overflow: scroll;
	}

	.sheet-kicker {
		font-family: "Barlow Condensed";
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 4px;
		color: #f0b429;
		margin-top: 14px;
		margin-bottom: 6px;
	}

	.shop-sheet .sheet-kicker:first-child {
		margin-top: 0px;
	}

	.sheet-row {
		flex-direction: row;
		width: 100%;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 3px;
	}

	.sheet-row .key {
		font-family: "Barlow Condensed";
		font-size: 14px;
		color: #8e8b86;
	}

	.sheet-row .vals {
		flex-direction: row;
		align-items: baseline;
	}

	.sheet-row .now {
		font-family: "Barlow Condensed";
		font-size: 16px;
		font-weight: 700;
		color: #f4ece0;
	}

	.sheet-row .arrow {
		font-size: 13px;
		color: #7b746a;
		margin-left: 8px;
		margin-right: 8px;
	}

	.sheet-row .next {
		font-family: "Barlow Condensed";
		font-size: 16px;
		font-weight: 700;
	}

	.sheet-row .next.up {
		color: #4fe07a;
	}

	.sheet-row .next.down {
		color: #e0453a;
	}

	.sheet-row .next.mixed {
		color: #f0b429;
	}
</style>
