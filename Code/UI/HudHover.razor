@namespace LoopedLoaded
@inherits PanelComponent

<root class="hover-layer">
	@if ( Card is TrinketDef tip )
	{
		<div class="card shop-offer upgrade-tip" style="border-color: @Hud.TraitBorder(tip)">
			<img class="shop-plate" src="ui/Arena UI/element_shop_left_btn.png" />
			<div class="shop-body">
				<img class="shop-icon" src="@tip.IconPath" />
				<div class="shop-name">
					<label class="title">@tip.ShownTitle</label>
					@if ( Trinkets.IsWeapon( tip ) )
					{
						<label class="weapon">@GameSettings.Text.Shop.Weapon</label>
					}
					else if ( tip.IsSkill )
					{
						<label class="weapon">@GameSettings.Text.Shop.Active</label>
					}
				</div>
				<label class="rarity" style="color: @Hud.TraitInk(tip)">@GameSettings.Text.RarityOf(tip.Pack)</label>
				@if ( Hud.OfferBlurb( tip ) is { Length: > 0 } blurb )
				{
					<label class="blurb">@blurb</label>
				}
				@if ( Hud.OfferLocks( tip ) is { Length: > 0 } locks )
				{
					<label class="blurb">@locks</label>
				}
				@if ( Hud.OfferUnlocks( tip ) is { Length: > 0 } opens )
				{
					<label class="blurb">@opens</label>
				}
				<div class="stats">
					@foreach ( var line in Hud.OfferStats( tip, true ) )
					{
						<label class="stat @line.Class">@line.Text</label>
					}
				</div>
			</div>
			<div class="shop-foot">
				@if ( Hud.OfferRank( tip, true ) is { Length: > 0 } rank )
				{
					<label class="rank">@rank</label>
				}
			</div>
		</div>
	}
	@if ( Look is not null && Look.Biomass && Loop.IsValid() )
	{
		<div class="biomass-tip">
			<img class="stat-back" src="ui/Arena UI/default_element_back.png" />
			<div class="stat-face">
				<div class="stat-row lead">
					<label class="key">@GameSettings.Text.Hud.Stash</label>
					<label class="value">@(Loop.City.IsValid() ? Loop.City.Warehouse : 0)</label>
				</div>
				<div class="stat-row lead">
					<label class="key">@GameSettings.Text.Hud.Fed</label>
					<label class="value">@GameSettings.Text.F(GameSettings.Text.Hud.FedValue, Loop.FedBiomass, Loop.WinNeed)</label>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Property] public GameLoop Loop { get; set; }
	[Property] public ArenaHud Hud { get; set; }
	[Property] public TipLook Look { get; set; }

	Sandbox.UI.Panel upgradeTip;
	Sandbox.UI.Panel biomassTip;
	float upgradeX = float.NaN;
	float upgradeY = float.NaN;
	float biomassX = float.NaN;
	float biomassY = float.NaN;
	bool stylesReady;

	TrinketDef Card
	{
		get
		{
			if ( Look is null || string.IsNullOrEmpty( Look.Chip ) || !Hud.IsValid() )
				return null;

			var card = Trinkets.Find( Look.Chip );
			return card;
		}
	}

	protected override void OnTreeFirstBuilt()
	{
		Panel.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
		Panel.Style.ZIndex = 120;
		AdoptStyles();
	}

	protected override void OnTreeBuilt()
	{
		upgradeTip = null;
		biomassTip = null;
		upgradeX = float.NaN;
		biomassX = float.NaN;
		AdoptStyles();
	}

	protected override void OnUpdate()
	{
		if ( Panel is null )
			return;

		AdoptStyles();
		PlaceUpgrade();
		PlaceBiomass();
	}

	protected override int BuildHash()
	{
		if ( Look is null || !Hud.IsValid() )
			return 1;

		var card = Card;
		var level = card is null || !Loop.IsValid() || !Loop.Inventory.IsValid()
			? 0
			: Loop.Inventory.Loadout.TraitLevel( card );
		return System.HashCode.Combine( 2, card?.Id, level, Look.Biomass ? 1 : 0, Loop.IsValid() ? Loop.Scrap : 0 );
	}

	void AdoptStyles()
	{
		if ( stylesReady || Panel is null || !Hud.IsValid() || Hud.Panel is null )
			return;

		var seen = new HashSet<Sandbox.UI.StyleSheet>();
		foreach ( var sheet in Panel.AllStyleSheets )
		{
			if ( sheet is not null )
				seen.Add( sheet );
		}

		foreach ( var sheet in Hud.Panel.AllStyleSheets )
		{
			if ( sheet is null || !seen.Add( sheet ) )
				continue;

			Panel.StyleSheet.Add( sheet );
		}

		stylesReady = true;
	}

	void PlaceUpgrade()
	{
		if ( Card is null )
			return;

		if ( !upgradeTip.IsValid() )
			upgradeTip = Find( "upgrade-tip" );
		if ( !upgradeTip.IsValid() || !Hud.IsValid() || Hud.Panel is null )
			return;

		var point = CursorOn( Hud.Panel );
		var w = upgradeTip.Box.Rect.Width;
		var h = upgradeTip.Box.Rect.Height;
		if ( w < 8f )
			w = 240f;
		if ( h < 8f )
			h = 320f;

		var x = point.x - w - 18f;
		var y = point.y - 24f;
		var bounds = Hud.Panel.Box.Rect;
		if ( bounds.Width > 64f && bounds.Height > 64f )
		{
			if ( x < 12f )
				x = point.x + 28f;

			x = Math.Clamp( x, 12f, Math.Max( 12f, bounds.Width - w - 12f ) );
			y = Math.Clamp( y, 12f, Math.Max( 12f, bounds.Height - h - 12f ) );
		}

		Place( upgradeTip, ref upgradeX, ref upgradeY, x, y );
	}

	void PlaceBiomass()
	{
		if ( Look is null || !Look.Biomass )
			return;

		if ( !biomassTip.IsValid() )
			biomassTip = Find( "biomass-tip" );
		if ( !biomassTip.IsValid() || !Hud.IsValid() || Hud.Panel is null )
			return;

		var point = CursorOn( Hud.Panel );
		var w = biomassTip.Box.Rect.Width;
		var h = biomassTip.Box.Rect.Height;
		if ( w < 8f )
			w = 320f;
		if ( h < 8f )
			h = 146f;

		var x = BiomassX();
		var y = point.y - 8f;
		var bounds = Hud.Panel.Box.Rect;
		if ( bounds.Width > 64f && bounds.Height > 64f )
		{
			x = Math.Clamp( x, 12f, Math.Max( 12f, bounds.Width - w - 12f ) );
			y = Math.Clamp( y, 12f, Math.Max( 12f, bounds.Height - h - 12f ) );
		}

		Place( biomassTip, ref biomassX, ref biomassY, x, y );
	}

	Sandbox.UI.Panel runLeft;

	float BiomassX()
	{
		const float gap = 14f;
		const float fallback = 678f;
		if ( !runLeft.IsValid() && Hud.IsValid() )
			runLeft = Find( Hud.Panel, "run-left" );
		if ( !runLeft.IsValid() )
			return fallback;

		var x = runLeft.Box.Rect.Left;
		var width = runLeft.Box.Rect.Width;
		var current = runLeft.Parent;
		while ( current.IsValid() && current != Hud.Panel )
		{
			x += current.Box.Rect.Left;
			current = current.Parent;
		}

		if ( width < 8f )
			return fallback;

		return x + width + gap;
	}

	static void Place( Sandbox.UI.Panel target, ref float placedX, ref float placedY, float x, float y )
	{
		if ( !float.IsNaN( placedX ) && MathF.Abs( placedX - x ) < 0.5f && MathF.Abs( placedY - y ) < 0.5f )
			return;

		placedX = x;
		placedY = y;
		target.Style.Position = Sandbox.UI.PositionMode.Absolute;
		target.Style.Left = Sandbox.UI.Length.Pixels( x );
		target.Style.Top = Sandbox.UI.Length.Pixels( y );
		target.Style.PointerEvents = Sandbox.UI.PointerEvents.None;
		target.Style.Dirty();
	}

	static Vector2 CursorOn( Sandbox.UI.Panel origin )
	{
		var scale = origin.ScaleFromScreen;
		if ( scale <= 0.0001f )
			scale = 1f;

		return Mouse.Position * scale;
	}

	Sandbox.UI.Panel Find( string className ) => Find( Panel, className );

	static Sandbox.UI.Panel Find( Sandbox.UI.Panel root, string className )
	{
		if ( root is null )
			return null;

		foreach ( var child in root.Descendants )
		{
			if ( child.HasClass( className ) )
				return child;
		}

		return null;
	}
}

<style>
	.hover-layer {
		position: absolute;
		left: 0px;
		top: 0px;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 120;
	}
</style>
