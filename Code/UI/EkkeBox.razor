@namespace LoopedLoaded
@using Sandbox.UI
@inherits Panel

<root class="ekke" onclick="@Advance">
	<div class="ekke-dim"></div>
	<div class="ekke-box">
		<img class="ekke-back" src="ui/Arena UI/default_element_back.png" />
		<div class="ekke-face">
			<div class="ekke-portrait">
				<EkkePortrait Loop="@Loop" class="ekke-model"></EkkePortrait>
			</div>
			<div class="ekke-copy">
				<label class="ekke-name">@GameSettings.Text.Talk.Name</label>
				<label class="ekke-words">* @TalkText</label>
			</div>
		</div>
	</div>
</root>

@code
{
	[Parameter] public GameLoop Loop { get; set; }

	string TalkText => Loop.IsValid() ? Loop.TalkText : "";

	void Advance() => Loop?.AdvanceTalk();

	protected override int BuildHash()
	{
		if ( !Loop.IsValid() )
			return 0;

		return System.HashCode.Combine( Loop.TalkCursor, Loop.TalkText );
	}
}

<style>
	.ekke {
		position: absolute;
		left: 0px;
		top: 0px;
		width: 100%;
		height: 100%;
		pointer-events: all;
		z-index: 70;
	}

	.ekke-dim {
		position: absolute;
		left: 0px;
		top: 0px;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.38);
	}

	.ekke-box {
		position: absolute;
		left: 50%;
		bottom: 24px;
		width: 900px;
		aspect-ratio: 477 / 217;
		transform: translateX( -450px );
		background-color: transparent;
		border: 0px solid transparent;
		border-radius: 0px;
		padding: 0px;
		overflow: hidden;
	}

	.ekke-back {
		position: absolute;
		left: 0px;
		top: 0px;
		width: 100%;
		height: 100%;
	}

	.ekke-face {
		position: absolute;
		left: 11%;
		top: 18%;
		width: 78%;
		height: 64%;
		flex-direction: row;
		align-items: stretch;
	}

	.ekke-portrait {
		width: 168px;
		height: 100%;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
	}

	.ekke-model {
		width: 148px;
		height: 148px;
		background-color: transparent;
	}

	.ekke .ekke-name {
		font-family: "Barlow Condensed";
		font-size: 34px;
		font-weight: 700;
		letter-spacing: 4px;
		color: #f0b429;
	}

	.ekke-copy {
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		flex-grow: 1;
		height: 100%;
		padding-left: 18px;
	}

	.ekke .ekke-words {
		font-family: "Barlow Condensed";
		font-size: 26px;
		font-weight: 600;
		color: #f4ece0;
		white-space: normal;
		letter-spacing: 0.4px;
		margin-top: 12px;
	}

</style>
